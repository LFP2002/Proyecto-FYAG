# Copiar fuera del repositorio. Este archivo no contiene valores de secretos.
FYAG_SECRET_DIR=/srv/fyag/secrets
FYAG_PUBLIC_HOST=fyag.example.org
FYAG_BIND_ADDRESS=127.0.0.1
FYAG_HTTP_PORT=80
FYAG_HTTPS_PORT=443
FYAG_RELEASE=local
FYAG_POSTGRES_DB=fyag
FYAG_POSTGRES_USER=fyag
FYAG_MONGO_APP_USER=fyag_documentos
FYAG_MONGO_ROOT_USER=fyag_bootstrap
FYAG_BLOQUEOS_PERFIL=deshabilitado
FYAG_CHAT_RETENCION_DIAS=30
FYAG_CHAT_PURGA_INTERVALO=3600
FYAG_CHAT_PURGA_AUTORIZADA=no

# Solo con el overlay SMTP autorizado. Completar ficheros de secreto externos.
