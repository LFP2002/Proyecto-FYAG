# ============================================================================
# FYAG | PLANTILLA DE VARIABLES DE ENTORNO (SIN SECRETOS)
# Copiar a .env y completar con secretos exclusivos del entorno.
# No reutilizar claves entre Django, JWT, Redis, MongoDB y PostgreSQL.
# ============================================================================

# 01. DJANGO | Aplicación y seguridad HTTP
DJANGO_SECRET_KEY=CAMBIAR_SECRETO_DJANGO
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 02. JWT | Tokens
JWT_SIGNING_KEY=CAMBIAR_SECRETO_JWT

# 03. POSTGRESQL
POSTGRES_DB=fyag_db
POSTGRES_USER=fyag_user
POSTGRES_PASSWORD=CAMBIAR_SECRETO_POSTGRESQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433

# 04. MONGODB | Principal
MONGO_INITDB_DATABASE=fyag_documentos
MONGO_HOST_PORT=27018
MONGO_INITDB_ROOT_USERNAME=fyag_bootstrap
MONGO_INITDB_ROOT_PASSWORD=CAMBIAR_SECRETO_ROOT_MONGO
FYAG_MONGO_HOST=mongodb
FYAG_MONGO_PORT=27017
FYAG_MONGO_DB=fyag_documentos
FYAG_MONGO_USER=fyag_app
FYAG_MONGO_PASSWORD=CAMBIAR_SECRETO_APP_MONGO

# 05. MONGODB | QA aislado
FYAG_MONGO_TEST_ROOT_USER=fyag_qa_bootstrap
FYAG_MONGO_TEST_ROOT_PASSWORD=CAMBIAR_SECRETO_ROOT_QA
FYAG_MONGO_TEST_USER=fyag_qa_app
FYAG_MONGO_TEST_PASSWORD=CAMBIAR_SECRETO_APP_QA

# 06. ALERTAS
FYAG_ALERTAS_INTERVALO_SEGUNDOS=60

# 07. EVIDENCIAS Y ADJUNTOS
FYAG_EVIDENCIAS_ROOT=/var/lib/fyag/evidencias
FYAG_ADJUNTOS_ROOT=/var/lib/fyag/adjuntos

# 08. CLAMAV
FYAG_CLAMD_HOST=clamav
FYAG_CLAMD_PORT=3310
FYAG_CLAMD_TEST_HOST=clamav_test
FYAG_CLAMD_TEST_PORT=3310

# 09. CHAT | Archivos y retención
FYAG_CHAT_ARCHIVOS_ROOT=/var/lib/fyag/chat
FYAG_CHAT_RETENCION_DIAS=30
FYAG_CHAT_PURGA_INTERVALO=3600

# 10. CHAT | Redis y WebSocket
FYAG_CHAT_REDIS_HOST=redis
FYAG_CHAT_REDIS_PORT=6379
FYAG_CHAT_REDIS_PASSWORD=CAMBIAR_SECRETO_HEXADECIMAL_REDIS
FYAG_CHAT_WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FYAG_CHAT_WS_TICKET_TTL=45
FYAG_CHAT_WS_HEARTBEAT=5
# Secreto distinto del chat; usar solo caracteres hexadecimales en Compose.
FYAG_SECURITY_REDIS_PASSWORD=
