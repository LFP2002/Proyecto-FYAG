DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=fyag_db
POSTGRES_USER=fyag_user
POSTGRES_PASSWORD=cambia-esta-clave

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433

MONGO_INITDB_DATABASE=fyag_documentos
MONGO_HOST_PORT=27018
# Generar claves locales independientes; no reutilizar root en Django.
MONGO_INITDB_ROOT_USERNAME=fyag_bootstrap
MONGO_INITDB_ROOT_PASSWORD=
FYAG_MONGO_HOST=mongodb
FYAG_MONGO_PORT=27017
FYAG_MONGO_DB=fyag_documentos
FYAG_MONGO_USER=fyag_app
FYAG_MONGO_PASSWORD=
# QA aislado. Nunca credenciales de desarrollo/producción.
FYAG_MONGO_TEST_ROOT_USER=fyag_qa_bootstrap
FYAG_MONGO_TEST_ROOT_PASSWORD=
FYAG_MONGO_TEST_USER=fyag_qa_app
FYAG_MONGO_TEST_PASSWORD=

JWT_SIGNING_KEY=cambia-esta-clave-jwt

# Proceso de reconciliación independiente (1-3600 segundos; default contractual 60).
FYAG_ALERTAS_INTERVALO_SEGUNDOS=60

# Adjuntos privados; no publicar esta raíz mediante servidor web.
FYAG_ADJUNTOS_ROOT=/var/lib/fyag/adjuntos
FYAG_CLAMD_HOST=clamav
FYAG_CLAMD_PORT=3310
FYAG_CLAMD_TEST_HOST=clamav_test
FYAG_CLAMD_TEST_PORT=3310
