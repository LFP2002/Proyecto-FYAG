{
  "info": {"name": "FYAG Beta — SPEC-019C-2 Mermas", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "Ejecutar en orden en QA aislado. Compatible con FYAG-Beta.postman_environment.json: base_url, token_af, token_gerencia. Configurar tokens locales B/T/S/otro T/TI, articulo_id activo con >=2 unidades valorizadas, entrega_id 019B de 6 unidades sin devoluciones previas en Obra operativa donde participa token_tecnico. UUID/merma/autorización capturados automáticamente. No Vault, IDs fijos ni credenciales. No depende de pruebas manuales externas. No reutilizar en producción. MB se ejecuta antes de MO/devoluciones para mantener corte físico."
  },
  "variable": [{"key": "token_bodega", "value": ""}, {"key": "token_tecnico", "value": ""}, {"key": "token_supervisor", "value": ""}, {"key": "token_otro_tecnico", "value": ""}, {"key": "token_ti", "value": ""}, {"key": "articulo_id", "value": ""}, {"key": "entrega_id", "value": ""}],
  "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_bodega}}", "type": "string"}]},
  "event": [
    {"listen": "prerequest", "script": {"type": "text/javascript", "exec": [
      "pm.variables.set('clave_nueva', pm.variables.replaceIn('{{$guid}}'));",
      "const n=Number(pm.info.requestName.slice(0,2)); const guardar=(clave,obj)=>{pm.collectionVariables.set(clave,JSON.stringify(obj));};",
      "if(n===1)guardar('crear_mb',{articulo:Number(pm.variables.get('articulo_id')),cantidad:'2.000',tipo:'DANO',motivo:'Material deteriorado no reutilizable QA',referencia_respaldo:'Acta QA',clave_idempotencia:pm.variables.get('clave_nueva')});",
      "if(n===3)guardar('decidir_mb',{decision:'APROBAR',motivo:'Pérdida verificada QA',clave_idempotencia:pm.variables.get('clave_nueva')});",
      "if(n===10)guardar('crear_mo',{entrega:Number(pm.variables.get('entrega_id')),cantidad:'2.000',tipo:'CORTE_NO_REUTILIZABLE',motivo:'Sobrante cortado inutilizable QA',actividad:'Instalación de manguera QA',clave_idempotencia:pm.variables.get('clave_nueva')});",
      "if(n===12)guardar('decidir_mo',{decision:'APROBAR',motivo:'Inutilización verificada QA',clave_idempotencia:pm.variables.get('clave_nueva')});",
      "if(n===24)guardar('rechazar_mb',{articulo:Number(pm.variables.get('articulo_id')),cantidad:'1.000',tipo:'OTRA',motivo:'Declaración por revisar QA',referencia_respaldo:'Acta rechazo QA',clave_idempotencia:pm.variables.get('clave_nueva')});"
    ]}},
    {"listen": "test", "script": {"type": "text/javascript", "exec": [
      "const n=Number(pm.info.requestName.slice(0,2)); const esperado=Number(pm.info.requestName.match(/— ([0-9]{3})/)[1]); pm.test('Status contratado',()=>pm.response.to.have.status(esperado));",
      "const nueva=pm.request.url.toString().includes('/mermas-'); if(nueva){pm.test('Cache privado',()=>pm.expect(pm.response.headers.get('Cache-Control')).to.eql('private, no-store'));pm.test('Vary Authorization',()=>pm.expect(pm.response.headers.get('Vary')).to.include('Authorization'));}",
      "if(pm.response.code<300){const d=pm.response.json(); if(n===1){pm.collectionVariables.set('merma_bodega_id',d.id);pm.collectionVariables.set('mb_original',JSON.stringify(d));} if(n===3)pm.collectionVariables.set('mb_decidida',JSON.stringify(d));if(n===9)pm.collectionVariables.set('autorizacion_devolucion_id',d.id);if(n===10){pm.collectionVariables.set('merma_obra_id',d.id);pm.collectionVariables.set('mo_original',JSON.stringify(d));}if(n===12)pm.collectionVariables.set('mo_decidida',JSON.stringify(d));if(n===24)pm.collectionVariables.set('merma_rechazo_id',d.id);",
      "if([2,4,14,15].includes(n)){const k={2:'mb_original',4:'mb_decidida',14:'mo_decidida',15:'mo_original'}[n];pm.test('Replay original',()=>pm.expect(d).to.deep.eql(JSON.parse(pm.collectionVariables.get(k))));pm.test('Replay true',()=>pm.expect(pm.response.headers.get('Idempotency-Replayed')).to.eql('true'));}",
      "if([1,2,6,10,11,15].includes(n)){pm.test('Sin economía protegida',()=>{for(const k of Object.keys(d))pm.expect(k).not.to.match(/costo|importe|saldo|gasto|huella/);});}",
      "if(n===5)pm.test('Pérdida histórica MB',()=>{pm.expect(d.estado).to.eql('APROBADA');pm.expect(d.importe_perdida).to.be.a('string');});",
      "if(n===11)pm.test('Sin operación física MO',()=>pm.expect(d.operacion).to.eql(null));",
      "if(n===13)pm.test('Valor MO informativo no aditivo',()=>{pm.expect(d.importe_informativo_no_aditivo).to.be.a('string');pm.expect(d.operacion).to.eql(null);});",
      "if(n===16)pm.test('Autorización intacta y recibible reducido',()=>{const a=d.results.find(x=>String(x.id)===String(pm.collectionVariables.get('autorizacion_devolucion_id')));pm.expect(a.cantidad).to.eql('6.000');pm.expect(a.cantidad_recibible_efectiva).to.eql('4.000');});",
      "if(n===25)pm.test('Rechazo sin operación',()=>{pm.expect(d.estado).to.eql('RECHAZADA');pm.expect(d.operacion).to.eql(null);});}"
    ]}}
  ],
  "item": [
    {"name": "01 Bodega informa MB — 201", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/mermas-bodega/", "body": {"mode": "raw", "raw": "{{crear_mb}}"}}},
    {"name": "02 Replay MB pendiente — 200", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/mermas-bodega/", "body": {"mode": "raw", "raw": "{{crear_mb}}"}}},
    {"name": "03 AF aprueba MB — 200", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_af}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/mermas-bodega/{{merma_bodega_id}}/decidir/", "body": {"mode": "raw", "raw": "{{decidir_mb}}"}}},
    {"name": "04 Replay aprobación MB — 200", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_af}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/mermas-bodega/{{merma_bodega_id}}/decidir/", "body": {"mode": "raw", "raw": "{{decidir_mb}}"}}},
    {"name": "05 Gerencia lee pérdida MB — 200", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_gerencia}}"}]}, "url": "{{base_url}}/api/inventario/mermas-bodega/{{merma_bodega_id}}/"}},
    {"name": "06 Bodega detalle sin importes — 200", "request": {"method": "GET", "url": "{{base_url}}/api/inventario/mermas-bodega/{{merma_bodega_id}}/"}},
    {"name": "07 Bodega no decide — 403", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/mermas-bodega/{{merma_bodega_id}}/decidir/", "body": {"mode": "raw", "raw": "{}"}}},
    {"name": "08 Supervisor no consulta MB — 403", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_supervisor}}"}]}, "url": "{{base_url}}/api/inventario/mermas-bodega/"}},
    {"name": "09 Supervisor autoriza devolución antes de MO — 201", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_supervisor}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/autorizaciones-devolucion/", "body": {"mode": "raw", "raw": "{\"entrega\":{{entrega_id}},\"cantidad\":\"6.000\",\"clave_idempotencia\":\"{{clave_nueva}}\"}"}}},
    {"name": "10 Técnico informa MO — 201", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_tecnico}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/mermas-obra/", "body": {"mode": "raw", "raw": "{{crear_mo}}"}}},
    {"name": "11 Técnico ve MO sin economía — 200", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_tecnico}}"}]}, "url": "{{base_url}}/api/inventario/mermas-obra/{{merma_obra_id}}/"}},
    {"name": "12 Supervisor aprueba MO — 200", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_supervisor}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/mermas-obra/{{merma_obra_id}}/decidir/", "body": {"mode": "raw", "raw": "{{decidir_mo}}"}}},
    {"name": "13 Gerencia ve MO informativa — 200", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_gerencia}}"}]}, "url": "{{base_url}}/api/inventario/mermas-obra/{{merma_obra_id}}/"}},
    {"name": "14 Replay aprobación MO — 200", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_supervisor}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/mermas-obra/{{merma_obra_id}}/decidir/", "body": {"mode": "raw", "raw": "{{decidir_mo}}"}}},
    {"name": "15 Replay creación MO sigue pendiente — 200", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_tecnico}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/mermas-obra/", "body": {"mode": "raw", "raw": "{{crear_mo}}"}}},
    {"name": "16 Autorización antigua recibible efectivo — 200", "request": {"method": "GET", "url": "{{base_url}}/api/inventario/autorizaciones-devolucion/?entrega={{entrega_id}}"}},
    {"name": "17 Bodega no recibe material perdido — 409", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/devoluciones/", "body": {"mode": "raw", "raw": "{\"autorizacion\":{{autorizacion_devolucion_id}},\"cantidad\":\"5.000\",\"clave_idempotencia\":\"{{clave_nueva}}\"}"}}},
    {"name": "18 Bodega recibe solo reutilizable — 201", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/devoluciones/", "body": {"mode": "raw", "raw": "{\"autorizacion\":{{autorizacion_devolucion_id}},\"cantidad\":\"4.000\",\"clave_idempotencia\":\"{{clave_nueva}}\"}"}}},
    {"name": "19 Otro Técnico no ve MO ajena — 404", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_otro_tecnico}}"}]}, "url": "{{base_url}}/api/inventario/mermas-obra/{{merma_obra_id}}/"}},
    {"name": "20 AF no consulta MO — 403", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_af}}"}]}, "url": "{{base_url}}/api/inventario/mermas-obra/"}},
    {"name": "21 TI sin acceso — 403", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_ti}}"}]}, "url": "{{base_url}}/api/inventario/mermas-bodega/"}},
    {"name": "22 Sin sesión — 401", "request": {"method": "GET", "auth": {"type": "noauth"}, "url": "{{base_url}}/api/inventario/mermas-bodega/"}},
    {"name": "23 Filtro económico prohibido — 400", "request": {"method": "GET", "url": "{{base_url}}/api/inventario/mermas-bodega/?importe=1"}},
    {"name": "24 Bodega informa MB para rechazar — 201", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/mermas-bodega/", "body": {"mode": "raw", "raw": "{{rechazar_mb}}"}}},
    {"name": "25 AF rechaza MB sin movimiento — 200", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_af}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/mermas-bodega/{{merma_rechazo_id}}/decidir/", "body": {"mode": "raw", "raw": "{\"decision\":\"RECHAZAR\",\"motivo\":\"Pérdida no acreditada QA\",\"clave_idempotencia\":\"{{clave_nueva}}\"}"}}},
    {"name": "26 Listado Bodega — 200", "request": {"method": "GET", "url": "{{base_url}}/api/inventario/mermas-bodega/?articulo={{articulo_id}}"}},
    {"name": "27 Listado Técnico — 200", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_tecnico}}"}]}, "url": "{{base_url}}/api/inventario/mermas-obra/?entrega={{entrega_id}}"}}
  ]
}
