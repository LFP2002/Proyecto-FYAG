{
  "info": {"name": "FYAG — SPEC-024 Supervisor y Finanzas (solo QA)", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "Ejecutar en orden SOLO sobre laboratorio aislado con un cliente activo de QA. Variables externas: base_url, cliente_id, supervisor_id, token_supervisor, token_af, token_gerencia. Tokens JWT de usuarios reales del rol indicado, generados localmente, nunca en Git. No precisa credenciales institucionales ni modifica Bodega/Obras. Crea propuestas nuevas cada ejecución; no limpiar bases existentes. Contrato OpenAPI SPEC-024-v1.json y SPEC-024-IMPLEMENTACION.md."},
  "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_supervisor}}", "type": "string"}]},
  "variable": [{"key": "presupuesto_id", "value": ""}, {"key": "origen_id", "value": ""}, {"key": "ajeno_id", "value": ""}, {"key": "item_id", "value": ""}, {"key": "item_extra_id", "value": ""}],
  "item": [
    {"name": "01 Selector Supervisor mínimo", "request": {"method": "GET", "url": "{{base_url}}/api/presupuestos/clientes-elegibles/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200',()=>pm.response.to.have.status(200));", "pm.test('Solo campos mínimos',()=>pm.response.json().results.forEach(x=>pm.expect(Object.keys(x).sort()).to.eql(['id','nombre_legal','tipo_cliente'])));", "pm.test('Página de 25',()=>pm.expect(pm.response.json().results.length).to.be.at.most(25));"]}}]},
    {"name": "02 Selector Finanzas", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_af}}", "type": "string"}]}, "url": "{{base_url}}/api/presupuestos/clientes-elegibles/?page=1"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200',()=>pm.response.to.have.status(200));"]}}]},
    {"name": "03 Selector Gerencia denegado", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_gerencia}}", "type": "string"}]}, "url": "{{base_url}}/api/presupuestos/clientes-elegibles/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('403',()=>pm.response.to.have.status(403));"]}}]},
    {"name": "04 Clientes general Supervisor denegado", "request": {"method": "GET", "url": "{{base_url}}/api/clientes/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('403',()=>pm.response.to.have.status(403));"]}}]},
    {"name": "05 Crear cliente Supervisor denegado", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}, "url": "{{base_url}}/api/clientes/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('403',()=>pm.response.to.have.status(403));"]}}]},
    {"name": "06 AF crea presupuesto ajeno a Supervisor", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_af}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"cliente\":{{cliente_id}},\"descripcion\":\"QA-024 creado AF\"}"}, "url": "{{base_url}}/api/presupuestos/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('201',()=>pm.response.to.have.status(201));", "if(pm.response.code===201) pm.collectionVariables.set('ajeno_id',pm.response.json().id);"]}}]},
    {"name": "07 Supervisor no ve presupuesto AF", "request": {"method": "GET", "url": "{{base_url}}/api/presupuestos/{{ajeno_id}}/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('404',()=>pm.response.to.have.status(404));"]}}]},
    {"name": "08 Supervisor no modifica ajeno", "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"descripcion\":\"No autorizado\"}"}, "url": "{{base_url}}/api/presupuestos/{{ajeno_id}}/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('404',()=>pm.response.to.have.status(404));"]}}]},
    {"name": "09 Gerencia no crea presupuestos", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_gerencia}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}, "url": "{{base_url}}/api/presupuestos/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('403',()=>pm.response.to.have.status(403));"]}}]},
    {"name": "10 Supervisor crea BORRADOR propio", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"cliente\":{{cliente_id}},\"descripcion\":\"QA-024 Supervisor\"}"}, "url": "{{base_url}}/api/presupuestos/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('201',()=>pm.response.to.have.status(201));", "if(pm.response.code===201) pm.collectionVariables.set('presupuesto_id',pm.response.json().id);", "pm.test('Autor real, borrador FINANZAS',()=>{const x=pm.response.json();pm.expect(x.creado_por).to.eql(Number(pm.environment.get('supervisor_id')));pm.expect(x.estado).to.eql('BORRADOR');pm.expect(x.politica_aprobacion).to.eql('FINANZAS');});"]}}]},
    {"name": "11 Supervisor modifica cabecera", "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"descripcion\":\"QA-024 alcance revisado\"}"}, "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200',()=>pm.response.to.have.status(200));"]}}]},
    {"name": "12 Supervisor agrega línea Decimal", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"descripcion\":\"Montaje libre sin Bodega\",\"cantidad\":\"2.500\",\"unidad\":\"hora\",\"precio_unitario\":\"100.25\",\"orden\":1}"}, "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/items/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('201',()=>pm.response.to.have.status(201));", "if(pm.response.code===201) pm.collectionVariables.set('item_id',pm.response.json().id);", "pm.test('Decimal HALF_UP',()=>pm.expect(pm.response.json().subtotal).to.eql('250.63'));"]}}]},
    {"name": "13 Supervisor modifica línea", "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"cantidad\":\"3.000\"}"}, "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/items/{{item_id}}/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200',()=>pm.response.to.have.status(200));", "pm.test('Decimal exacto',()=>pm.expect(pm.response.json().subtotal).to.eql('300.75'));"]}}]},
    {"name": "14 Supervisor crea línea extra", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"descripcion\":\"Extra QA\",\"cantidad\":\"1\",\"unidad\":\"unidad\",\"precio_unitario\":\"0\",\"orden\":2}"}, "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/items/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('201',()=>pm.response.to.have.status(201));", "if(pm.response.code===201) pm.collectionVariables.set('item_extra_id',pm.response.json().id);"]}}]},
    {"name": "15 Supervisor elimina línea extra", "request": {"method": "DELETE", "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/items/{{item_extra_id}}/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('204',()=>pm.response.to.have.status(204));"]}}]},
    {"name": "16 Supervisor envía a Finanzas", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}, "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/enviar-finanzas/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200',()=>pm.response.to.have.status(200));", "pm.test('Pendiente',()=>pm.expect(pm.response.json().estado).to.eql('PENDIENTE_FINANZAS'));"]}}]},
    {"name": "17 Finanzas no edita pendiente", "request": {"method": "PATCH", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_af}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"descripcion\":\"No editar\"}"}, "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('409',()=>pm.response.to.have.status(409));"]}}]},
    {"name": "18 Supervisor no aprueba", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}, "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/aprobar-finanzas/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('403',()=>pm.response.to.have.status(403));"]}}]},
    {"name": "19 Gerencia no aprueba", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_gerencia}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}, "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/aprobar-finanzas/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('403',()=>pm.response.to.have.status(403));"]}}]},
    {"name": "20 AF rechaza con motivo", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_af}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"motivo\":\"QA ajustar alcance\"}"}, "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/rechazar-finanzas/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200',()=>pm.response.to.have.status(200));", "pm.test('Rechazado',()=>pm.expect(pm.response.json().estado).to.eql('RECHAZADO_FINANZAS'));", "pm.collectionVariables.set('origen_id',pm.collectionVariables.get('presupuesto_id'));"]}}]},
    {"name": "21 Supervisor crea revisión vinculada", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}, "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/crear-revision/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('201',()=>pm.response.to.have.status(201));", "pm.test('Origen, autor, líneas y política',()=>{const x=pm.response.json();pm.expect(x.presupuesto_origen).to.eql(Number(pm.collectionVariables.get('origen_id')));pm.expect(x.creado_por).to.eql(Number(pm.environment.get('supervisor_id')));pm.expect(x.estado).to.eql('BORRADOR');pm.expect(x.politica_aprobacion).to.eql('FINANZAS');pm.expect(x.items).to.have.lengthOf(1);pm.expect(x.items[0].id).not.to.eql(Number(pm.collectionVariables.get('item_id')));});", "if(pm.response.code===201) pm.collectionVariables.set('presupuesto_id',pm.response.json().id);"]}}]},
    {"name": "22 Rechazado original sigue intacto", "request": {"method": "GET", "url": "{{base_url}}/api/presupuestos/{{origen_id}}/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200',()=>pm.response.to.have.status(200));", "pm.test('Rechazo y neto intactos',()=>{pm.expect(pm.response.json().estado).to.eql('RECHAZADO_FINANZAS');pm.expect(pm.response.json().monto_neto).to.eql('300.75');});"]}}]},
    {"name": "23 Supervisor envía revisión", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}, "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/enviar-finanzas/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200',()=>pm.response.to.have.status(200));"]}}]},
    {"name": "24 AF aprueba revisión", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_af}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}, "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/aprobar-finanzas/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200',()=>pm.response.to.have.status(200));", "pm.test('Aprobado financiero',()=>pm.expect(pm.response.json().estado).to.eql('APROBADO_FINANZAS'));"]}}]},
    {"name": "25 AF registra envío cliente", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_af}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}, "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/enviar-cliente/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200',()=>pm.response.to.have.status(200));", "pm.test('Enviado cliente',()=>pm.expect(pm.response.json().estado).to.eql('ENVIADO_CLIENTE'));"]}}]},
    {"name": "26 AF registra aprobación cliente", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_af}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}, "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/registrar-aprobacion-cliente/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200',()=>pm.response.to.have.status(200));", "pm.test('Aprobado cliente',()=>pm.expect(pm.response.json().estado).to.eql('APROBADO_CLIENTE'));"]}}]},
    {"name": "27 Supervisor consulta historial posterior", "request": {"method": "GET", "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/historial/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200',()=>pm.response.to.have.status(200));", "pm.test('Cinco hitos reales',()=>pm.expect(pm.response.json().results.map(e=>e.estado_nuevo)).to.eql(['BORRADOR','PENDIENTE_FINANZAS','APROBADO_FINANZAS','ENVIADO_CLIENTE','APROBADO_CLIENTE']));"]}}]},
    {"name": "28 Gerencia consulta sin decidir", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_gerencia}}", "type": "string"}]}, "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200',()=>pm.response.to.have.status(200));"]}}]},
    {"name": "29 Supervisor no revisa aprobado", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}, "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/crear-revision/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('409',()=>pm.response.to.have.status(409));"]}}]},
    {"name": "30 Ruta gerencial sigue retirada", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_gerencia}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}, "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/aprobar-gerencia/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('403',()=>pm.response.to.have.status(403));"]}}]},
    {"name": "31 Sin JWT", "request": {"method": "GET", "auth": {"type": "noauth"}, "url": "{{base_url}}/api/presupuestos/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('401',()=>pm.response.to.have.status(401));"]}}]},
    {"name": "32 OPTIONS selector S", "request": {"method": "OPTIONS", "url": "{{base_url}}/api/presupuestos/clientes-elegibles/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200',()=>pm.response.to.have.status(200));", "pm.test('Sin POST',()=>pm.expect(pm.response.headers.get('Allow')).not.to.include('POST'));"]}}]}
  ]
}
