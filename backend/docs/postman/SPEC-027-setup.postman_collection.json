{
  "info": {"name": "FYAG SPEC-027 — Primera TI QA", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key":"api","value":"http://127.0.0.1:8000"},{"key":"csrf","value":""},{"key":"email_qa","value":"primera-ti@qa.test"}],
  "item": [
    {"name":"01 Instalación pendiente","request":{"method":"GET","url":"{{api}}/api/auth/setup/estado/"},"event":[{"listen":"test","script":{"exec":["pm.test('Solo estado pendiente', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.eql({pendiente:true}); });"]}}]},
    {"name":"02 CSRF","request":{"method":"GET","url":"{{api}}/api/auth/csrf/"},"event":[{"listen":"test","script":{"exec":["pm.test('CSRF 200', () => pm.response.to.have.status(200));","pm.collectionVariables.set('csrf', pm.response.json().csrfToken);"]}}]},
    {"name":"03 Crear primera TI","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-CSRFToken","value":"{{csrf}}"}],"body":{"mode":"raw","raw":"{\"first_name\":\"Operadora\",\"last_name\":\"Sintética\",\"username\":\"ti_sintetica\",\"email\":\"{{email_qa}}\",\"password\":\"{{password_qa}}\",\"password_confirm\":\"{{password_qa}}\",\"clave_instalacion\":\"{{clave_qa}}\"}"},"url":"{{api}}/api/auth/setup/"},"event":[{"listen":"test","script":{"exec":["pm.test('201 sin sesión', () => { pm.response.to.have.status(201); pm.expect(pm.response.headers.has('Set-Cookie')).to.eql(false); pm.expect(pm.response.json()).to.have.all.keys('detail'); });"]}}]},
    {"name":"04 Reutilización denegada","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-CSRFToken","value":"{{csrf}}"}],"body":{"mode":"raw","raw":"{\"first_name\":\"Operadora\",\"last_name\":\"Sintética\",\"username\":\"ti_sintetica\",\"email\":\"{{email_qa}}\",\"password\":\"{{password_qa}}\",\"password_confirm\":\"{{password_qa}}\",\"clave_instalacion\":\"{{clave_qa}}\"}"},"url":"{{api}}/api/auth/setup/"},"event":[{"listen":"test","script":{"exec":["pm.test('409 genérico', () => { pm.response.to.have.status(409); pm.expect(pm.response.json().code).to.eql('setup_no_autorizado'); });"]}}]},
    {"name":"05 Instalación cerrada","request":{"method":"GET","url":"{{api}}/api/auth/setup/estado/"},"event":[{"listen":"test","script":{"exec":["pm.test('Solo estado cerrado', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.eql({pendiente:false}); });","pm.collectionVariables.unset('csrf');"]}}]}
  ]
}
