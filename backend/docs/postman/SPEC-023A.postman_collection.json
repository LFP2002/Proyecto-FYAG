{
  "info": {"name": "FYAG Beta — SPEC-023A Chat REST y archivos privados", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "QA exclusivo, ejecutar en orden. Compatible con FYAG-Beta environment (base_url). Configurar localmente tokens de tres cuentas elegibles, IDs de destinatario/tercero y rutas a PNG/JPEG/PDF válidos y documento DOCX no admitido. Sin Vault, credenciales o IDs reales. La cuenta tercero no pertenece a la conversación directa; sí se añade al grupo. UUIDs/IDs se capturan. No ejecutar purga sobre datos institucionales: retención y recuperación se prueban en suite automatizada y comando QA. Sin conexión WS."
  },
  "variable": [{"key": "token_chat_emisor", "value": ""}, {"key": "token_chat_destinatario", "value": ""}, {"key": "token_chat_tercero", "value": ""}, {"key": "chat_emisor_id", "value": ""}, {"key": "chat_destinatario_id", "value": ""}, {"key": "chat_tercero_id", "value": ""}, {"key": "chat_archivo_png", "value": ""}, {"key": "chat_archivo_jpeg", "value": ""}, {"key": "chat_archivo_pdf", "value": ""}, {"key": "chat_archivo_no_admitido", "value": ""}],
  "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_chat_emisor}}", "type": "string"}]},
  "event": [
    {"listen": "prerequest", "script": {"type": "text/javascript", "exec": [
      "const n=Number(pm.info.requestName.slice(0,2));pm.variables.set('clave_nueva',pm.variables.replaceIn('{{$guid}}'));",
      "const guardar=(k,obj)=>pm.collectionVariables.set(k,JSON.stringify(obj));",
      "if(n===2)guardar('chat_crear_directa',{tipo:'DIRECTA',destinatario:Number(pm.variables.get('chat_destinatario_id')),clave_idempotencia:pm.variables.get('clave_nueva')});",
      "if(n===7)guardar('chat_publicar_texto',{texto:'Mensaje de QA — texto plano',clave_idempotencia:pm.variables.get('clave_nueva')});",
      "if(n===15)guardar('chat_crear_grupo',{tipo:'GRUPAL',titulo:'Equipo QA',participantes:[Number(pm.variables.get('chat_destinatario_id')),Number(pm.variables.get('chat_tercero_id'))],clave_idempotencia:pm.variables.get('clave_nueva')});",
      "if(n===20)pm.collectionVariables.set('chat_uuid_archivo',pm.variables.get('clave_nueva'));"
    ]}},
    {"listen": "test", "script": {"type": "text/javascript", "exec": [
      "const n=Number(pm.info.requestName.slice(0,2));const esperado=Number(pm.info.requestName.match(/— ([0-9]{3})/)[1]);pm.test('Status contratado',()=>{if(n===2)pm.expect(pm.response.code).to.be.oneOf([200,201]);else pm.response.to.have.status(esperado);});",
      "pm.test('Cache privado',()=>pm.expect(pm.response.headers.get('Cache-Control')).to.eql('private, no-store'));pm.test('Vary Authorization',()=>pm.expect(pm.response.headers.get('Vary')).to.include('Authorization'));pm.test('Nosniff',()=>pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'));",
      "if((pm.response.headers.get('Content-Type')||'').includes('application/json')){const d=pm.response.json();const revisar=x=>{if(x&&typeof x==='object')for(const [k,v]of Object.entries(x)){pm.expect(['email','password','sha256','huella','clave_interna','ruta','sesion_version','refresh','access']).not.to.include(k);revisar(v);}};pm.test('Sin metadatos protegidos',()=>revisar(d));",
      "if(n===2)pm.collectionVariables.set('chat_conversacion_id',d.id);if(n===7){pm.collectionVariables.set('chat_mensaje_id',d.id);pm.collectionVariables.set('chat_texto_original',JSON.stringify(d));}if(n===15)pm.collectionVariables.set('chat_grupo_id',d.id);if(n===20){pm.collectionVariables.set('chat_archivo_id',d.archivo.id);pm.collectionVariables.set('chat_archivo_original',JSON.stringify(d));}",
      "if([3,4].includes(n))pm.test('Misma pareja, mismo ID',()=>pm.expect(String(d.id)).to.eql(String(pm.collectionVariables.get('chat_conversacion_id'))));",
      "if([8,21].includes(n)){pm.test('Replay sin duplicación',()=>pm.expect(d).to.deep.eql(JSON.parse(pm.collectionVariables.get(n===8?'chat_texto_original':'chat_archivo_original'))));pm.test('Replay true',()=>pm.expect(pm.response.headers.get('Idempotency-Replayed')).to.eql('true'));}",
      "if(n===10)pm.test('Contador no leído',()=>pm.expect(d.no_leidos).to.be.above(0));if(n===12)pm.test('Cursor propio avanzado',()=>{pm.expect(String(d.ultimo_leido_mensaje_id)).to.eql(String(pm.collectionVariables.get('chat_mensaje_id')));pm.expect(d.no_leidos).to.eql(0);});",
      "if(n===16)pm.test('Tres participantes fijos',()=>pm.expect(d.participantes).to.have.lengthOf(3));if(n===24)pm.test('Orden DESC',()=>{const ids=d.results.map(m=>m.id);pm.expect(ids).to.deep.eql([...ids].sort((a,b)=>b-a));});}",
      "if(n===22)pm.test('Descarga attachment',()=>pm.expect(pm.response.headers.get('Content-Disposition')).to.include('attachment'));"
    ]}}
  ],
  "item": [
    {"name": "01 Directorio elegible mínimo — 200", "request": {"method": "GET", "url": "{{base_url}}/api/chat/usuarios/"}},
    {"name": "02 Crear directa — 201", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/chat/conversaciones/", "body": {"mode": "raw", "raw": "{{chat_crear_directa}}"}}},
    {"name": "03 Replay directa — 200", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/chat/conversaciones/", "body": {"mode": "raw", "raw": "{{chat_crear_directa}}"}}},
    {"name": "04 Directa inversa no duplica pareja — 200", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_chat_destinatario}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/chat/conversaciones/", "body": {"mode": "raw", "raw": "{\"tipo\":\"DIRECTA\",\"destinatario\":{{chat_emisor_id}},\"clave_idempotencia\":\"{{clave_nueva}}\"}"}}},
    {"name": "05 Listar conversaciones propias — 200", "request": {"method": "GET", "url": "{{base_url}}/api/chat/conversaciones/"}},
    {"name": "06 Detalle de directa y participantes — 200", "request": {"method": "GET", "url": "{{base_url}}/api/chat/conversaciones/{{chat_conversacion_id}}/"}},
    {"name": "07 Publicar texto — 201", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/chat/conversaciones/{{chat_conversacion_id}}/mensajes/", "body": {"mode": "raw", "raw": "{{chat_publicar_texto}}"}}},
    {"name": "08 Replay texto — 200", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/chat/conversaciones/{{chat_conversacion_id}}/mensajes/", "body": {"mode": "raw", "raw": "{{chat_publicar_texto}}"}}},
    {"name": "09 Misma UUID texto diferente — 409", "event": [{"listen": "prerequest", "script": {"exec": ["const d=JSON.parse(pm.collectionVariables.get('chat_publicar_texto'));d.texto='Carga distinta QA';pm.variables.set('chat_texto_conflictivo',JSON.stringify(d));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/chat/conversaciones/{{chat_conversacion_id}}/mensajes/", "body": {"mode": "raw", "raw": "{{chat_texto_conflictivo}}"}}},
    {"name": "10 Destinatario ve no leído — 200", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_chat_destinatario}}"}]}, "url": "{{base_url}}/api/chat/conversaciones/{{chat_conversacion_id}}/"}},
    {"name": "11 Destinatario marca leído — 200", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_chat_destinatario}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/chat/conversaciones/{{chat_conversacion_id}}/leido/", "body": {"mode": "raw", "raw": "{\"ultimo_mensaje_id\":{{chat_mensaje_id}}}"}}},
    {"name": "12 Lectura propia actualizada — 200", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_chat_destinatario}}"}]}, "url": "{{base_url}}/api/chat/conversaciones/{{chat_conversacion_id}}/"}},
    {"name": "13 Tercero no lee directa — 404", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_chat_tercero}}"}]}, "url": "{{base_url}}/api/chat/conversaciones/{{chat_conversacion_id}}/mensajes/"}},
    {"name": "14 Tercero no publica — 404", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_chat_tercero}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/chat/conversaciones/{{chat_conversacion_id}}/mensajes/", "body": {"mode": "raw", "raw": "{\"texto\":\"No autorizado QA\",\"clave_idempotencia\":\"{{clave_nueva}}\"}"}}},
    {"name": "15 Crear grupo de tres — 201", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/chat/conversaciones/", "body": {"mode": "raw", "raw": "{{chat_crear_grupo}}"}}},
    {"name": "16 Detalle grupal — 200", "request": {"method": "GET", "url": "{{base_url}}/api/chat/conversaciones/{{chat_grupo_id}}/"}},
    {"name": "17 Publicar en grupo — 201", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/chat/conversaciones/{{chat_grupo_id}}/mensajes/", "body": {"mode": "raw", "raw": "{\"texto\":\"Mensaje grupal QA\",\"clave_idempotencia\":\"{{clave_nueva}}\"}"}}},
    {"name": "18 Tercero sí pertenece al grupo — 200", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_chat_tercero}}"}]}, "url": "{{base_url}}/api/chat/conversaciones/{{chat_grupo_id}}/mensajes/"}},
    {"name": "19 No editar título o miembros — 405", "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/chat/conversaciones/{{chat_grupo_id}}/", "body": {"mode": "raw", "raw": "{\"titulo\":\"Cambio no permitido\"}"}}},
    {"name": "20 PNG privado con texto — 201", "request": {"method": "POST", "header": [{"key": "Idempotency-Key", "value": "{{chat_uuid_archivo}}"}], "url": "{{base_url}}/api/chat/conversaciones/{{chat_conversacion_id}}/archivos/", "body": {"mode": "formdata", "formdata": [{"key": "archivo", "type": "file", "src": "{{chat_archivo_png}}"}, {"key": "texto", "type": "text", "value": "Imagen QA"}]}}},
    {"name": "21 Replay PNG sin segundo archivo — 200", "request": {"method": "POST", "header": [{"key": "Idempotency-Key", "value": "{{chat_uuid_archivo}}"}], "url": "{{base_url}}/api/chat/conversaciones/{{chat_conversacion_id}}/archivos/", "body": {"mode": "formdata", "formdata": [{"key": "archivo", "type": "file", "src": "{{chat_archivo_png}}"}, {"key": "texto", "type": "text", "value": "Imagen QA"}]}}},
    {"name": "22 Descargar privado — 200", "request": {"method": "GET", "url": "{{base_url}}/api/chat/archivos/{{chat_archivo_id}}/descargar/"}},
    {"name": "23 Tercero no descarga — 404", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_chat_tercero}}"}]}, "url": "{{base_url}}/api/chat/archivos/{{chat_archivo_id}}/descargar/"}},
    {"name": "24 Historial con archivo — 200", "request": {"method": "GET", "url": "{{base_url}}/api/chat/conversaciones/{{chat_conversacion_id}}/mensajes/"}},
    {"name": "25 Historial cursor exclusivo — 200", "request": {"method": "GET", "url": "{{base_url}}/api/chat/conversaciones/{{chat_conversacion_id}}/mensajes/?antes_id={{chat_mensaje_id}}"}},
    {"name": "26 Solo PDF — 201", "request": {"method": "POST", "header": [{"key": "Idempotency-Key", "value": "{{clave_nueva}}"}], "url": "{{base_url}}/api/chat/conversaciones/{{chat_conversacion_id}}/archivos/", "body": {"mode": "formdata", "formdata": [{"key": "archivo", "type": "file", "src": "{{chat_archivo_pdf}}"}]}}},
    {"name": "27 Solo JPEG — 201", "request": {"method": "POST", "header": [{"key": "Idempotency-Key", "value": "{{clave_nueva}}"}], "url": "{{base_url}}/api/chat/conversaciones/{{chat_conversacion_id}}/archivos/", "body": {"mode": "formdata", "formdata": [{"key": "archivo", "type": "file", "src": "{{chat_archivo_jpeg}}"}]}}},
    {"name": "28 DOCX no habilitado — 400", "request": {"method": "POST", "header": [{"key": "Idempotency-Key", "value": "{{clave_nueva}}"}], "url": "{{base_url}}/api/chat/conversaciones/{{chat_conversacion_id}}/archivos/", "body": {"mode": "formdata", "formdata": [{"key": "archivo", "type": "file", "src": "{{chat_archivo_no_admitido}}"}]}}},
    {"name": "29 Mensaje vacío — 400", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/chat/conversaciones/{{chat_conversacion_id}}/mensajes/", "body": {"mode": "raw", "raw": "{\"texto\":\"   \",\"clave_idempotencia\":\"{{clave_nueva}}\"}"}}},
    {"name": "30 Autor desde cliente prohibido — 400", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/chat/conversaciones/{{chat_conversacion_id}}/mensajes/", "body": {"mode": "raw", "raw": "{\"texto\":\"QA\",\"autor\":{{chat_tercero_id}},\"clave_idempotencia\":\"{{clave_nueva}}\"}"}}},
    {"name": "31 Filtro ajeno prohibido — 400", "request": {"method": "GET", "url": "{{base_url}}/api/chat/conversaciones/?usuario={{chat_tercero_id}}"}},
    {"name": "32 Sin autenticación — 401", "request": {"method": "GET", "auth": {"type": "noauth"}, "url": "{{base_url}}/api/chat/usuarios/"}},
    {"name": "33 Cursor de lectura ajeno denegado — 404", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_chat_tercero}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/chat/conversaciones/{{chat_conversacion_id}}/leido/", "body": {"mode": "raw", "raw": "{\"ultimo_mensaje_id\":{{chat_mensaje_id}}}"}}}
  ]
}
