{
  "info": {"name": "FYAG Beta — SPEC-019C-1 Solicitudes de materiales", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "QA exclusivo, ejecutar en orden. Reutilizar FYAG-Beta.postman_environment.json (base_url, token_af, token_gerencia). Configurar localmente token_tecnico, token_otro_tecnico, token_supervisor, token_bodega, token_ti, obra_id operativa y articulo_id activo. El primer Técnico debe ser participante activo; otro Técnico es otra identidad. Para los despachos, preparar stock valorizado mediante 019A/019B. Los UUID y los IDs de solicitudes/autorizaciones se capturan automáticamente. No hay Vault, IDs fijos ni credenciales reales. Esta colección no crea pagos. La ejecución manual de compañeros no bloquea el desarrollo."
  },
  "variable": [
    {"key": "token_tecnico", "value": ""}, {"key": "token_otro_tecnico", "value": ""}, {"key": "token_supervisor", "value": ""}, {"key": "token_bodega", "value": ""}, {"key": "token_ti", "value": ""},
    {"key": "obra_id", "value": ""}, {"key": "articulo_id", "value": ""}, {"key": "cantidad_solicitada", "value": "4.000"}, {"key": "cantidad_aprobada", "value": "3.000"}, {"key": "cantidad_despacho", "value": "1.000"}
  ],
  "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_tecnico}}", "type": "string"}]},
  "event": [
    {"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["pm.variables.set('clave_nueva', pm.variables.replaceIn('{{$guid}}'));"]}},
    {"listen": "test", "script": {"type": "text/javascript", "exec": [
      "const esperado = Number(pm.info.requestName.match(/— ([0-9]{3})/)[1]); pm.test('Status contratado', () => pm.response.to.have.status(esperado));",
      "const nuevaRuta = /\\/(solicitudes-materiales|articulos-solicitables)\\//.test(pm.request.url.toString()); if (nuevaRuta) { pm.test('Cache privado', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('private, no-store')); pm.test('Vary Authorization', () => pm.expect(pm.response.headers.get('Vary')).to.include('Authorization')); }",
      "if (nuevaRuta && pm.response.code < 300) { const revisar = dato => { if (dato && typeof dato === 'object') for (const [campo,valor] of Object.entries(dato)) { pm.expect(['saldo','stock','existencias','precio','costo_unitario_neto','promedio','promedio_anterior','promedio_posterior','saldo_valorado','gasto','movimiento','huella']).not.to.include(campo); revisar(valor); } }; pm.test('Proyección sin stock ni economía', () => revisar(pm.response.json())); }"
    ]}}
  ],
  "item": [
    {"name": "01 Técnico consulta catálogo solicitable — 200", "event": [{"listen": "test", "script": {"exec": ["pm.test('Solo campos publicados', () => pm.response.json().results.forEach(a => pm.expect(Object.keys(a).sort()).to.deep.eql(['codigo','id','nombre','unidad'])));"]}}], "request": {"method": "GET", "url": "{{base_url}}/api/inventario/articulos-solicitables/"}},
    {"name": "02 Técnico crea solicitud — 201", "event": [{"listen": "prerequest", "script": {"exec": ["pm.collectionVariables.set('clave_creacion', pm.variables.get('clave_nueva'));", "pm.collectionVariables.set('cuerpo_creacion', JSON.stringify({obra:Number(pm.variables.get('obra_id')),articulo:Number(pm.variables.get('articulo_id')),cantidad:pm.variables.get('cantidad_solicitada'),justificacion:'Material adicional para Obra QA',clave_idempotencia:pm.collectionVariables.get('clave_creacion')}));"]}}, {"listen": "test", "script": {"exec": ["pm.collectionVariables.set('solicitud_id', pm.response.json().id); pm.collectionVariables.set('respuesta_creacion', JSON.stringify(pm.response.json()));", "pm.test('Pendiente sin autorización', () => { pm.expect(pm.response.json().estado).to.eql('PENDIENTE'); pm.expect(pm.response.json().autorizacion).to.eql(null); });"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/solicitudes-materiales/", "body": {"mode": "raw", "raw": "{{cuerpo_creacion}}"}}},
    {"name": "03 Replay de creación — 200", "event": [{"listen": "test", "script": {"exec": ["pm.test('Creación original', () => pm.expect(pm.response.json()).to.deep.eql(JSON.parse(pm.collectionVariables.get('respuesta_creacion'))));", "pm.test('Replay true', () => pm.expect(pm.response.headers.get('Idempotency-Replayed')).to.eql('true'));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/solicitudes-materiales/", "body": {"mode": "raw", "raw": "{{cuerpo_creacion}}"}}},
    {"name": "04 Técnico consulta detalle propio — 200", "event": [{"listen": "test", "script": {"exec": ["pm.test('Historia de creación', () => pm.expect(pm.response.json().historial.map(e => e.tipo)).to.deep.eql(['CREACION']));"]}}], "request": {"method": "GET", "url": "{{base_url}}/api/inventario/solicitudes-materiales/{{solicitud_id}}/"}},
    {"name": "05 Otro Técnico no ve detalle ajeno — 404", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_otro_tecnico}}"}]}, "url": "{{base_url}}/api/inventario/solicitudes-materiales/{{solicitud_id}}/"}},
    {"name": "06 Otro Técnico no enumera solicitud ajena — 200", "event": [{"listen": "test", "script": {"exec": ["pm.test('Scope propio', () => pm.expect(pm.response.json().results.map(s => String(s.id))).not.to.include(String(pm.collectionVariables.get('solicitud_id'))));"]}}], "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_otro_tecnico}}"}]}, "url": "{{base_url}}/api/inventario/solicitudes-materiales/?obra={{obra_id}}&articulo={{articulo_id}}"}},
    {"name": "07 Bodega no consulta solicitudes — 403", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_bodega}}"}]}, "url": "{{base_url}}/api/inventario/solicitudes-materiales/"}},
    {"name": "08 Finanzas no consulta solicitudes — 403", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_af}}"}]}, "url": "{{base_url}}/api/inventario/solicitudes-materiales/"}},
    {"name": "09 Técnico no decide — 403", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/solicitudes-materiales/{{solicitud_id}}/decidir/", "body": {"mode": "raw", "raw": "{}"}}},
    {"name": "10 Supervisor aprueba parcialmente — 200", "event": [{"listen": "prerequest", "script": {"exec": ["pm.collectionVariables.set('clave_decision', pm.variables.get('clave_nueva')); pm.collectionVariables.set('cuerpo_decision', JSON.stringify({decision:'APROBAR',cantidad_aprobada:pm.variables.get('cantidad_aprobada'),motivo:'Aprobación parcial por necesidad técnica QA',clave_idempotencia:pm.collectionVariables.get('clave_decision')}));"]}}, {"listen": "test", "script": {"exec": ["pm.collectionVariables.set('autorizacion_id', pm.response.json().autorizacion); pm.collectionVariables.set('respuesta_decision', JSON.stringify(pm.response.json()));", "pm.test('Aprobación parcial', () => { pm.expect(pm.response.json().estado).to.eql('APROBADA'); pm.expect(pm.response.json().cantidad_aprobada).to.eql(pm.variables.get('cantidad_aprobada')); pm.expect(pm.response.json().autorizacion).to.be.a('number'); });", "pm.test('No replay inicial', () => pm.expect(pm.response.headers.get('Idempotency-Replayed')).to.eql('false'));"]}}], "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_supervisor}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/solicitudes-materiales/{{solicitud_id}}/decidir/", "body": {"mode": "raw", "raw": "{{cuerpo_decision}}"}}},
    {"name": "11 Replay de decisión sin nueva autorización — 200", "event": [{"listen": "test", "script": {"exec": ["pm.test('Misma decisión', () => pm.expect(pm.response.json()).to.deep.eql(JSON.parse(pm.collectionVariables.get('respuesta_decision'))));", "pm.test('Replay true', () => pm.expect(pm.response.headers.get('Idempotency-Replayed')).to.eql('true'));"]}}], "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_supervisor}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/solicitudes-materiales/{{solicitud_id}}/decidir/", "body": {"mode": "raw", "raw": "{{cuerpo_decision}}"}}},
    {"name": "12 Segunda decisión con otra clave — 409", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_supervisor}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/solicitudes-materiales/{{solicitud_id}}/decidir/", "body": {"mode": "raw", "raw": "{\"decision\":\"RECHAZAR\",\"motivo\":\"Otra decisión QA\",\"clave_idempotencia\":\"{{clave_nueva}}\"}"}}},
    {"name": "13 Técnico ve decisión e historial — 200", "event": [{"listen": "test", "script": {"exec": ["pm.test('Historial inmutable', () => { const s=pm.response.json(); pm.expect(s.historial.map(e => e.tipo)).to.deep.eql(['CREACION','APROBACION']); pm.expect(s.historial[0].actor).to.eql(s.solicitante); pm.expect(s.historial[1].actor).to.eql(s.decidido_por); });"]}}], "request": {"method": "GET", "url": "{{base_url}}/api/inventario/solicitudes-materiales/{{solicitud_id}}/"}},
    {"name": "14 Replay de creación tras aprobar — 200", "event": [{"listen": "test", "script": {"exec": ["pm.test('Imagen original PENDIENTE', () => pm.expect(pm.response.json()).to.deep.eql(JSON.parse(pm.collectionVariables.get('respuesta_creacion'))));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/solicitudes-materiales/", "body": {"mode": "raw", "raw": "{{cuerpo_creacion}}"}}},
    {"name": "15 Bodega consulta autorización 019B — 200", "event": [{"listen": "test", "script": {"exec": ["pm.test('Autorización disponible en 019B', () => pm.expect(pm.response.json().results.map(a => String(a.id))).to.include(String(pm.collectionVariables.get('autorizacion_id'))));"]}}], "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_bodega}}"}]}, "url": "{{base_url}}/api/inventario/autorizaciones-entrega/?obra={{obra_id}}&articulo={{articulo_id}}"}},
    {"name": "16 Bodega despacha por ruta 019B — 201", "event": [{"listen": "prerequest", "script": {"exec": ["pm.collectionVariables.set('clave_entrega', pm.variables.get('clave_nueva')); pm.collectionVariables.set('cuerpo_entrega', JSON.stringify({autorizacion:Number(pm.collectionVariables.get('autorizacion_id')),cantidad:pm.variables.get('cantidad_despacho'),clave_idempotencia:pm.collectionVariables.get('clave_entrega')}));"]}}, {"listen": "test", "script": {"exec": ["pm.collectionVariables.set('respuesta_entrega', JSON.stringify(pm.response.json()));"]}}], "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_bodega}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/entregas/", "body": {"mode": "raw", "raw": "{{cuerpo_entrega}}"}}},
    {"name": "17 Replay de despacho 019B — 200", "event": [{"listen": "test", "script": {"exec": ["pm.test('Mismo despacho', () => pm.expect(pm.response.json()).to.deep.eql(JSON.parse(pm.collectionVariables.get('respuesta_entrega'))));"]}}], "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_bodega}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/entregas/", "body": {"mode": "raw", "raw": "{{cuerpo_entrega}}"}}},
    {"name": "18 Técnico no consulta existencias — 403", "request": {"method": "GET", "url": "{{base_url}}/api/inventario/existencias/"}},
    {"name": "19 Técnico no consulta autorizaciones 019B — 403", "request": {"method": "GET", "url": "{{base_url}}/api/inventario/autorizaciones-entrega/"}},
    {"name": "20 Gerencia consulta solicitudes — 200", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_gerencia}}"}]}, "url": "{{base_url}}/api/inventario/solicitudes-materiales/?obra={{obra_id}}&estado=APROBADA"}},
    {"name": "21 Técnico crea otra solicitud para rechazo — 201", "event": [{"listen": "test", "script": {"exec": ["pm.collectionVariables.set('solicitud_rechazo_id', pm.response.json().id);"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/solicitudes-materiales/", "body": {"mode": "raw", "raw": "{\"obra\":{{obra_id}},\"articulo\":{{articulo_id}},\"cantidad\":\"1.000\",\"justificacion\":\"Solicitud adicional QA para revisar rechazo\",\"clave_idempotencia\":\"{{clave_nueva}}\"}"}}},
    {"name": "22 Supervisor rechaza con motivo — 200", "event": [{"listen": "prerequest", "script": {"exec": ["pm.collectionVariables.set('cuerpo_rechazo', JSON.stringify({decision:'RECHAZAR',motivo:'No corresponde nuevo material QA',clave_idempotencia:pm.variables.get('clave_nueva')}));"]}}, {"listen": "test", "script": {"exec": ["pm.collectionVariables.set('respuesta_rechazo', JSON.stringify(pm.response.json()));", "pm.test('Sin autorización al rechazar', () => { pm.expect(pm.response.json().estado).to.eql('RECHAZADA'); pm.expect(pm.response.json().autorizacion).to.eql(null); });"]}}], "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_supervisor}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/solicitudes-materiales/{{solicitud_rechazo_id}}/decidir/", "body": {"mode": "raw", "raw": "{{cuerpo_rechazo}}"}}},
    {"name": "23 Replay de rechazo — 200", "event": [{"listen": "test", "script": {"exec": ["pm.test('Mismo rechazo', () => pm.expect(pm.response.json()).to.deep.eql(JSON.parse(pm.collectionVariables.get('respuesta_rechazo'))));"]}}], "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_supervisor}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/solicitudes-materiales/{{solicitud_rechazo_id}}/decidir/", "body": {"mode": "raw", "raw": "{{cuerpo_rechazo}}"}}},
    {"name": "24 Técnico consulta rechazo — 200", "request": {"method": "GET", "url": "{{base_url}}/api/inventario/solicitudes-materiales/{{solicitud_rechazo_id}}/"}},
    {"name": "25 Campo precio no aceptado — 400", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/solicitudes-materiales/", "body": {"mode": "raw", "raw": "{\"obra\":{{obra_id}},\"articulo\":{{articulo_id}},\"cantidad\":\"1.000\",\"justificacion\":\"QA\",\"precio\":\"1.00\",\"clave_idempotencia\":\"{{clave_nueva}}\"}"}}},
    {"name": "26 Cantidad float no aceptada — 400", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/solicitudes-materiales/", "body": {"mode": "raw", "raw": "{\"obra\":{{obra_id}},\"articulo\":{{articulo_id}},\"cantidad\":1.5,\"justificacion\":\"QA\",\"clave_idempotencia\":\"{{clave_nueva}}\"}"}}},
    {"name": "27 UUID de decisión con otra carga — 409", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_supervisor}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/solicitudes-materiales/{{solicitud_id}}/decidir/", "body": {"mode": "raw", "raw": "{\"decision\":\"RECHAZAR\",\"motivo\":\"Otra carga QA\",\"clave_idempotencia\":\"{{clave_decision}}\"}"}}},
    {"name": "28 Sin sesión — 401", "request": {"method": "GET", "auth": {"type": "noauth"}, "url": "{{base_url}}/api/inventario/solicitudes-materiales/"}},
    {"name": "29 Catálogo rechaza filtro de saldo — 400", "request": {"method": "GET", "url": "{{base_url}}/api/inventario/articulos-solicitables/?saldo=1"}},
    {"name": "30 TI sin acceso al dominio — 403", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_ti}}"}]}, "url": "{{base_url}}/api/inventario/solicitudes-materiales/"}}
  ]
}
