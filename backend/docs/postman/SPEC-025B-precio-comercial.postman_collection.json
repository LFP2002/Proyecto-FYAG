{
  "info": {
    "name": "FYAG — SPEC-025B Precio comercial (solo QA)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden contra un laboratorio aislado. Configurar base_url, cliente_id activo, articulo_id activo, token_supervisor y token_af. No usar credenciales reales ni guardar tokens en Git. No genera movimientos de Bodega."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token_supervisor}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "presupuesto_id",
      "value": ""
    },
    {
      "key": "item_id",
      "value": ""
    },
    {
      "key": "version_comercial",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Supervisor crea borrador",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/presupuestos/",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"cliente\":{{cliente_id}},\"descripcion\":\"QA cotización de Bodega\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201',()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201) pm.collectionVariables.set('presupuesto_id',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Supervisor añade material sin precio ni unidad manual",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/items/",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"articulo\":{{articulo_id}},\"cantidad\":\"2.500\",\"orden\":1}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 sin precio ni subtotal',()=>{pm.response.to.have.status(201);const i=pm.response.json();pm.expect(i.precio_unitario).to.eql(null);pm.expect(i.subtotal).to.eql(null);});",
              "if(pm.response.code===201) pm.collectionVariables.set('item_id',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Supervisor envía con precio pendiente",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/enviar-finanzas/",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('En revisión con neto pendiente',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().estado).to.eql('PENDIENTE_FINANZAS');pm.expect(pm.response.json().monto_neto).to.eql(null);});"
            ]
          }
        }
      ]
    },
    {
      "name": "Finanzas no puede aprobar sin precio",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/aprobar-finanzas/",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_af}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('400 precio pendiente',()=>{pm.response.to.have.status(400);pm.expect(pm.response.json()).to.have.property('precio_unitario');});"
            ]
          }
        }
      ]
    },
    {
      "name": "Finanzas fija exclusivamente el precio de venta",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/items/{{item_id}}/precio-comercial/",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_af}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"precio_unitario\":\"8500.00\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 y subtotal exacto',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().subtotal).to.eql('21250.00');});"
            ]
          }
        }
      ]
    },
    {
      "name": "Finanzas revisa detalle actualizado",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_af}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 huella comercial',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().version_comercial).to.match(/^[0-9a-f]{64}$/);});",
              "pm.collectionVariables.set('version_comercial',pm.response.json().version_comercial);"
            ]
          }
        }
      ]
    },
    {
      "name": "Finanzas aprueba con precio completo",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/presupuestos/{{presupuesto_id}}/aprobar-finanzas/",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_af}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"version_comercial_esperada\":\"{{version_comercial}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 y neto completo',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().monto_neto).to.eql('21250.00');});"
            ]
          }
        }
      ]
    }
  ]
}
