{
  "info": {"name": "FYAG Beta — SPEC-019B Entregas, devoluciones y costo promedio", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "QA exclusivo, ejecutar en orden. Reutiliza FYAG-Beta.postman_environment.json: base_url, token_af, token_gerencia y token_denegado. Configurar token_bodega, token_supervisor y obra_id operativa como variables locales; articulo_historico_id debe tener stock anterior al corte pendiente de regularización. No genera pagos. No persistir tokens en Git. Nueva ejecución requiere artículo histórico distinto sin regularización previa."
  },
  "variable": [{"key": "token_bodega", "value": ""}, {"key": "token_supervisor", "value": ""}, {"key": "obra_id", "value": ""}, {"key": "articulo_historico_id", "value": ""}],
  "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_bodega}}", "type": "string"}]},
  "event": [
    {"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["pm.variables.set('uuid', pm.variables.replaceIn('{{$guid}}'));", "if (!pm.collectionVariables.get('codigo_019b')) pm.collectionVariables.set('codigo_019b', 'qa019b-'+pm.variables.replaceIn('{{$guid}}').slice(0,8));"]}},
    {"listen": "test", "script": {"type": "text/javascript", "exec": [
      "const expected = Number(pm.info.requestName.match(/— ([0-9]{3})/)[1]); pm.test('Status contratado', () => pm.response.to.have.status(expected));",
      "const legacy = /\\/(articulos|ingresos|movimientos)\\//.test(pm.request.url.toString()); if (!legacy) { pm.test('Cache privado', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('private, no-store')); pm.test('Vary Authorization', () => pm.expect(pm.response.headers.get('Vary')).to.include('Authorization')); }",
      "if (pm.info.requestName.includes('[B]') && pm.response.code < 300) { const check = x => { if (x && typeof x === 'object') for (const [k,v] of Object.entries(x)) { pm.expect(['gasto','costo_unitario_neto','promedio_anterior','promedio_posterior','saldo_valorado_anterior','saldo_valorado_posterior']).not.to.include(k); check(v); } }; pm.test('Bodega sin información económica', () => check(pm.response.json())); }"
    ]}}
  ],
  "item": [
    {"name": "01 [B] Catálogo nuevo — 201", "event": [{"listen": "test", "script": {"exec": ["pm.collectionVariables.set('articulo_id', pm.response.json().id);"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/articulos/", "body": {"mode": "raw", "raw": "{\"codigo\":\"{{codigo_019b}}\",\"nombre\":\"Material ficticio QA 019B\",\"unidad\":\"kg\"}"}}},
    {"name": "02 [B] Recepción física sin precio — 201", "event": [{"listen": "prerequest", "script": {"exec": ["pm.collectionVariables.set('ingreso_body', JSON.stringify({articulo:Number(pm.collectionVariables.get('articulo_id')),cantidad:'10.000',clave_idempotencia:pm.variables.get('uuid')}));"]}}, {"listen": "test", "script": {"exec": ["pm.collectionVariables.set('ingreso_id', pm.response.json().id); pm.collectionVariables.set('ingreso_original', JSON.stringify(pm.response.json()));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/ingresos/", "body": {"mode": "raw", "raw": "{{ingreso_body}}"}}},
    {"name": "03 [B] Replay ingreso — 200", "event": [{"listen": "test", "script": {"exec": ["pm.test('Ingreso original', () => pm.expect(pm.response.json()).to.deep.eql(JSON.parse(pm.collectionVariables.get('ingreso_original'))));", "pm.test('Replay true', () => pm.expect(pm.response.headers.get('Idempotency-Replayed')).to.eql('true'));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/ingresos/", "body": {"mode": "raw", "raw": "{{ingreso_body}}"}}},
    {"name": "04 [S] Autoriza cantidad sin reserva — 201", "event": [{"listen": "test", "script": {"exec": ["pm.collectionVariables.set('autorizacion_id', pm.response.json().id);"]}}], "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_supervisor}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/autorizaciones-entrega/", "body": {"mode": "raw", "raw": "{\"obra\":{{obra_id}},\"articulo\":{{articulo_id}},\"cantidad\":\"6.000\",\"clave_idempotencia\":\"{{uuid}}\"}"}}},
    {"name": "05 [B] Despacho pendiente de valoración — 409", "event": [{"listen": "prerequest", "script": {"exec": ["pm.collectionVariables.set('despacho_body', JSON.stringify({autorizacion:Number(pm.collectionVariables.get('autorizacion_id')),cantidad:'2.000',clave_idempotencia:pm.variables.get('uuid')}));"]}}, {"listen": "test", "script": {"exec": ["pm.test('Pendiente', () => pm.expect(pm.response.json().code).to.eql('valoracion_pendiente'));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/entregas/", "body": {"mode": "raw", "raw": "{{despacho_body}}"}}},
    {"name": "06 [B] No consulta precios — 403", "request": {"method": "GET", "url": "{{base_url}}/api/inventario/valorizaciones/"}},
    {"name": "07 [AF] Respalda costo neto — 201", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_af}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/valorizaciones/", "body": {"mode": "raw", "raw": "{\"ingreso\":{{ingreso_id}},\"costo_unitario_neto\":\"100.00\",\"referencia\":\"QA-NETO-019B\",\"clave_idempotencia\":\"{{uuid}}\"}"}}},
    {"name": "08 [AF] Regulariza histórico sin ingreso físico — 201", "event": [{"listen": "prerequest", "script": {"exec": ["pm.collectionVariables.set('regularizacion_body', JSON.stringify({articulo:Number(pm.variables.get('articulo_historico_id')),costo_unitario_neto:'100.00',referencia:'QA-CORTE-HISTORICO',motivo:'Valor neto documentado de stock anterior al corte',clave_idempotencia:pm.variables.get('uuid')}));"]}}, {"listen": "test", "script": {"exec": ["pm.collectionVariables.set('regularizacion_original', JSON.stringify(pm.response.json()));"]}}], "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_af}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/regularizaciones-iniciales/", "body": {"mode": "raw", "raw": "{{regularizacion_body}}"}}},
    {"name": "09 [B] Estado sin montos — 200", "request": {"method": "GET", "url": "{{base_url}}/api/inventario/estados-valorizacion/?articulo={{articulo_id}}"}},
    {"name": "10 [B] Despacho parcial efectivo — 201", "event": [{"listen": "test", "script": {"exec": ["pm.collectionVariables.set('entrega_id', pm.response.json().id); pm.collectionVariables.set('entrega_original', JSON.stringify(pm.response.json()));", "pm.test('Movimiento vinculado', () => pm.expect(pm.response.json().movimiento).to.be.a('number'));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/entregas/", "body": {"mode": "raw", "raw": "{{despacho_body}}"}}},
    {"name": "11 [B] Replay despacho — 200", "event": [{"listen": "test", "script": {"exec": ["pm.test('Entrega original', () => pm.expect(pm.response.json()).to.deep.eql(JSON.parse(pm.collectionVariables.get('entrega_original'))));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/entregas/", "body": {"mode": "raw", "raw": "{{despacho_body}}"}}},
    {"name": "12 [B] Nueva recepción — 201", "event": [{"listen": "test", "script": {"exec": ["pm.collectionVariables.set('ingreso2_id', pm.response.json().id);"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/ingresos/", "body": {"mode": "raw", "raw": "{\"articulo\":{{articulo_id}},\"cantidad\":\"4.000\",\"clave_idempotencia\":\"{{uuid}}\"}"}}},
    {"name": "13 [AF] Segundo precio y promedio móvil — 201", "event": [{"listen": "test", "script": {"exec": ["pm.test('Promedio HALF_UP', () => pm.expect(pm.response.json().promedio_posterior).to.eql('133.33'));"]}}], "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_af}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/valorizaciones/", "body": {"mode": "raw", "raw": "{\"ingreso\":{{ingreso2_id}},\"costo_unitario_neto\":\"200.00\",\"referencia\":\"QA-NETO-SEGUNDO\",\"clave_idempotencia\":\"{{uuid}}\"}"}}},
    {"name": "14 [S] Autoriza devolución parcial — 201", "event": [{"listen": "test", "script": {"exec": ["pm.collectionVariables.set('retorno_id', pm.response.json().id);"]}}], "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_supervisor}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/autorizaciones-devolucion/", "body": {"mode": "raw", "raw": "{\"entrega\":{{entrega_id}},\"cantidad\":\"1.000\",\"clave_idempotencia\":\"{{uuid}}\"}"}}},
    {"name": "15 [B] Confirma devolución física — 201", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/devoluciones/", "body": {"mode": "raw", "raw": "{\"autorizacion\":{{retorno_id}},\"cantidad\":\"1.000\",\"clave_idempotencia\":\"{{uuid}}\"}"}}},
    {"name": "16 [B] Replay despacho tras devolución — 200", "event": [{"listen": "test", "script": {"exec": ["pm.test('Misma entrega original', () => pm.expect(pm.response.json()).to.deep.eql(JSON.parse(pm.collectionVariables.get('entrega_original'))));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/entregas/", "body": {"mode": "raw", "raw": "{{despacho_body}}"}}},
    {"name": "17 [B] UUID con otra carga — 409", "event": [{"listen": "prerequest", "script": {"exec": ["const p=JSON.parse(pm.collectionVariables.get('despacho_body')); p.cantidad='3.000'; pm.variables.set('colision_body', JSON.stringify(p));"]}}, {"listen": "test", "script": {"exec": ["pm.test('Conflicto UUID', () => pm.expect(pm.response.json().code).to.eql('idempotencia_conflictiva'));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/entregas/", "body": {"mode": "raw", "raw": "{{colision_body}}"}}},
    {"name": "18 [S] Consulta entrega y gasto original — 200", "event": [{"listen": "test", "script": {"exec": ["pm.test('Costo histórico congelado', () => pm.expect(pm.response.json().results[0].costo_unitario_neto).to.eql('100.00'));"]}}], "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_supervisor}}"}]}, "url": "{{base_url}}/api/inventario/entregas/?autorizacion={{autorizacion_id}}"}},
    {"name": "19 [G] Lee valoraciones — 200", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_gerencia}}"}]}, "url": "{{base_url}}/api/inventario/valorizaciones/?articulo={{articulo_id}}"}},
    {"name": "20 [B] Libro SALIDA sin precios — 200", "request": {"method": "GET", "url": "{{base_url}}/api/inventario/movimientos/?tipo=SALIDA&articulo={{articulo_id}}"}},
    {"name": "21 [T] Rol denegado — 403", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_denegado}}"}]}, "url": "{{base_url}}/api/inventario/entregas/"}},
    {"name": "22 [G] Escritura denegada — 403", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_gerencia}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/autorizaciones-entrega/", "body": {"mode": "raw", "raw": "{}"}}},
    {"name": "23 [AF] Replay regularización — 200", "event": [{"listen": "test", "script": {"exec": ["pm.test('Regularización original', () => pm.expect(pm.response.json()).to.deep.eql(JSON.parse(pm.collectionVariables.get('regularizacion_original'))));"]}}], "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_af}}"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/regularizaciones-iniciales/", "body": {"mode": "raw", "raw": "{{regularizacion_body}}"}}},
    {"name": "24 [B] Lista devoluciones sin costos — 200", "request": {"method": "GET", "url": "{{base_url}}/api/inventario/devoluciones/?entrega={{entrega_id}}"}},
    {"name": "25 [AF] Lista regularizaciones — 200", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_af}}"}]}, "url": "{{base_url}}/api/inventario/regularizaciones-iniciales/?articulo={{articulo_historico_id}}"}},
    {"name": "26 [S] Lista autorizaciones entrega — 200", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_supervisor}}"}]}, "url": "{{base_url}}/api/inventario/autorizaciones-entrega/?obra={{obra_id}}"}},
    {"name": "27 [S] Lista autorizaciones devolución — 200", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token_supervisor}}"}]}, "url": "{{base_url}}/api/inventario/autorizaciones-devolucion/?entrega={{entrega_id}}"}},
    {"name": "28 [B] Precio no aceptado en despacho — 400", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/api/inventario/entregas/", "body": {"mode": "raw", "raw": "{\"autorizacion\":{{autorizacion_id}},\"cantidad\":\"1.000\",\"costo_unitario_neto\":\"1.00\",\"clave_idempotencia\":\"{{uuid}}\"}"}}}
  ]
}
