              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Metodo": {
        "description": "Método no publicado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflicto": {
        "description": "Conflicto de estado/idempotencia, sin SQL ni valores económicos",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Conflicto"
            }
          }
        }
      }
    }
