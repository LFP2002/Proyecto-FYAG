        "properties": {
          "code": {
            "enum": [
              "estado_incompatible",
              "idempotencia_conflictiva",
              "merma_ya_decidida",
              "corte_desactualizado",
              "existencia_insuficiente",
              "valoracion_pendiente",
              "remanente_insuficiente",
              "importe_fuera_rango"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "MermaFinanzas": {
        "allOf": [
          {
            "$ref": "#/components/schemas/MermaBase"
          },
          {
            "type": "object",
            "required": [
