        "unevaluatedProperties": false
      },
      "DetalleFinanzas": {
        "allOf": [
          {
            "$ref": "#/components/schemas/MermaFinanzas"
          },
          {
            "required": [
              "historial"
            ]
          }
        ]
      },
      "PaginaFinanzas": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "count",
          "next",
          "previous",
          "results",
          "resumen"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "next": {
            "type": [
              "string",
              "null"
            ]
          },
          "previous": {
            "type": [
              "string",
              "null"
            ]
          },
          "results": {
            "type": "array",
            "maxItems": 25,
            "items": {
