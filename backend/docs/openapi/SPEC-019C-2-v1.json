                "type": "integer",
                "minimum": 0
              },
              "aprobadas": {
                "type": "integer",
                "minimum": 0
              },
              "rechazadas": {
                "type": "integer",
                "minimum": 0
              },
              "perdida_neta": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]{2}$"
              }
            }
          }
        }
      }
    },
    "responses": {
