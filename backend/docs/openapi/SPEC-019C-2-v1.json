            "properties": {
              "articulo_nombre": {
                "type": "string"
              },
              "articulo_codigo": {
                "type": "string"
              },
              "informado_nombre": {
                "type": "string"
              },
              "decidido_nombre": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
