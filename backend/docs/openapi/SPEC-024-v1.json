{
  "openapi": "3.1.0",
  "info": {"title": "FYAG — Presupuestos SPEC-024", "version": "1.0.0", "description": "Contrato vigente 003B + 020A + 024. Supervisor (S): propios en SQL, elaborar/enviar borradores y revisar propios RECHAZADO_FINANZAS. Administrativo/Finanzas (AF): todos, decisiones exclusivas. Gerencia (G): lectura. Otros perfiles: 403, sin bypass staff/superuser. Clientes CRUD permanece AF-only. JWT, actividad, versión, contraseña, PERSONAL y bloqueo operativo vigentes. Edición solo BORRADOR para S/AF. Sin Bodega, impuestos ni envío real de correo. PresupuestoEvento registra estados, no cada edición."},
  "servers": [{"url": "/"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/api/presupuestos/": {
      "get": {"operationId": "listarPresupuestos024", "description": "S: solo creado_por propio, en cualquier estado. AF/G: todos. Orden -creado_en,-id, 25 por página, sin N+1.", "parameters": [{"$ref": "#/components/parameters/Page"}], "responses": {"200": {"description": "Página", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Pagina"}}}}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}}},
      "post": {"operationId": "crearPresupuesto024", "description": "S/AF. Cliente activo bajo bloqueo. BORRADOR FINANZAS, creado_por servidor y un evento inicial. Sin ítems anidados. No requiere dos empleados AF distintos.", "requestBody": {"$ref": "#/components/requestBodies/Cabecera"}, "responses": {"201": {"$ref": "#/components/responses/Detalle"}, "400": {"$ref": "#/components/responses/Datos"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}}}
    },
    "/api/presupuestos/clientes-elegibles/": {
      "get": {"operationId": "clientesElegibles024", "description": "Solo S/AF, también en OPTIONS. Clientes activos exclusivamente, proyección SQL id/nombre_legal/tipo_cliente, sin RUT/contacto/correo/teléfono. Orden nombre_legal,id; 25 por página. Query estricta: solo buscar/page, sin repetidos. Nombre: substring case-insensitive no vacío tras trim, máximo 200. No concede GET ni escrituras en /api/clientes/.", "parameters": [{"$ref": "#/components/parameters/Page"}, {"name": "buscar", "in": "query", "schema": {"type": "string", "minLength": 1, "maxLength": 200}}], "responses": {"200": {"description": "Página mínima", "content": {"application/json": {"schema": {"type": "object", "required": ["count", "next", "previous", "results"], "properties": {"count": {"type": "integer", "minimum": 0}, "next": {"type": ["string", "null"]}, "previous": {"type": ["string", "null"]}, "results": {"type": "array", "maxItems": 25, "items": {"$ref": "#/components/schemas/ClienteElegible"}}}}}}}, "400": {"$ref": "#/components/responses/Datos"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/Ausente"}, "405": {"description": "Sin escritura"}}}
    },
    "/api/presupuestos/{id}/": {
      "parameters": [{"$ref": "#/components/parameters/Id"}],
      "get": {"operationId": "detallePresupuesto024", "description": "S propio / AF/G todos. Ítems ordenados orden,id y neto calculados del mismo conjunto leído.", "responses": {"200": {"$ref": "#/components/responses/Detalle"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/Ausente"}}},
      "patch": {"operationId": "editarPresupuesto024", "description": "S propio / AF cualquiera; solo BORRADOR. Presupuesto -> Cliente si se reasigna. Cliente recibido debe estar activo aunque sea el mismo ID. Autor/política/historia no se modifican. PUT y DELETE no implementados (405 para rol admitido).", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CabeceraParcial"}}}}, "responses": {"200": {"$ref": "#/components/responses/Detalle"}, "400": {"$ref": "#/components/responses/Datos"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/Ausente"}, "409": {"$ref": "#/components/responses/Estado"}}}
    },
    "/api/presupuestos/{id}/items/": {
      "parameters": [{"$ref": "#/components/parameters/Id"}],
      "post": {"operationId": "crearItem024", "description": "S propio / AF todos, solo BORRADOR. Línea comercial libre, sin artículo/stock/compra/reserva/gasto. Bloquea Presupuesto antes del ítem.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"allOf": [{"$ref": "#/components/schemas/ItemEntrada"}], "required": ["descripcion", "cantidad", "unidad", "precio_unitario", "orden"]}}}}, "responses": {"201": {"description": "Ítem", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Item"}}}}, "400": {"$ref": "#/components/responses/Datos"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/Ausente"}, "409": {"$ref": "#/components/responses/Estado"}}}
    },
    "/api/presupuestos/{id}/items/{item_id}/": {
      "parameters": [{"$ref": "#/components/parameters/Id"}, {"name": "item_id", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/Id"}}],
      "patch": {"operationId": "editarItem024", "description": "S propio / AF, solo BORRADOR. Scope del presupuesto antes de buscar ítem o validar body. Orden único dentro de presupuesto.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ItemEntrada"}}}}, "responses": {"200": {"description": "Ítem", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Item"}}}}, "400": {"$ref": "#/components/responses/Datos"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/Ausente"}, "409": {"$ref": "#/components/responses/Estado"}}},
      "delete": {"operationId": "eliminarItem024", "description": "S propio / AF, solo BORRADOR. No renumera otras líneas.", "responses": {"204": {"description": "Sin cuerpo"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/Ausente"}, "409": {"$ref": "#/components/responses/Estado"}}}
    },
    "/api/presupuestos/{id}/historial/": {
      "parameters": [{"$ref": "#/components/parameters/Id"}],
      "get": {"operationId": "historialPresupuesto024", "description": "S propio / AF/G todos. Paginación 25, orden creado_en,id. Historial solo de estados, inmutable por aplicación.", "parameters": [{"$ref": "#/components/parameters/Page"}], "responses": {"200": {"description": "Página de eventos reales", "content": {"application/json": {"schema": {"type": "object", "required": ["count", "next", "previous", "results"], "properties": {"count": {"type": "integer", "minimum": 0}, "next": {"type": ["string", "null"]}, "previous": {"type": ["string", "null"]}, "results": {"type": "array", "maxItems": 25, "items": {"$ref": "#/components/schemas/Evento"}}}}}}}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/Ausente"}}}
    },
    "/api/presupuestos/{id}/enviar-finanzas/": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "enviarFinanzas024", "description": "S propio o AF. BORRADOR -> PENDIENTE_FINANZAS; cliente activo, >=1 ítem válido y neto positivo. Congela cabecera/ítems incluso para AF. Alerta existente solo para AF tras commit, sin notificación operacional nueva para G. No correo.", "requestBody": {"$ref": "#/components/requestBodies/Accion"}, "responses": {"200": {"$ref": "#/components/responses/Detalle"}, "400": {"$ref": "#/components/responses/Datos"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/Ausente"}, "409": {"$ref": "#/components/responses/Estado"}}}},
    "/api/presupuestos/{id}/aprobar-finanzas/": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "aprobarFinanzas024", "description": "AF exclusivo, también sobre creación propia. PENDIENTE_FINANZAS o PENDIENTE_GERENCIA legado -> APROBADO_FINANZAS, sin cambiar política/historia anterior. No crea Obra.", "requestBody": {"$ref": "#/components/requestBodies/Accion"}, "responses": {"200": {"$ref": "#/components/responses/Detalle"}, "400": {"$ref": "#/components/responses/Datos"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/Ausente"}, "409": {"$ref": "#/components/responses/Estado"}}}},
    "/api/presupuestos/{id}/rechazar-finanzas/": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "rechazarFinanzas024", "description": "AF exclusivo. Ambos pendientes -> RECHAZADO_FINANZAS. Motivo obligatorio. Origen queda congelado; S propietario puede crear revisión.", "requestBody": {"$ref": "#/components/requestBodies/Motivo"}, "responses": {"200": {"$ref": "#/components/responses/Detalle"}, "400": {"$ref": "#/components/responses/Datos"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/Ausente"}, "409": {"$ref": "#/components/responses/Estado"}}}},
    "/api/presupuestos/{id}/enviar-cliente/": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "enviarCliente024", "description": "AF exclusivo. APROBADO_FINANZAS o APROBADO_GERENCIA legado -> ENVIADO_CLIENTE. No correo real.", "requestBody": {"$ref": "#/components/requestBodies/Accion"}, "responses": {"200": {"$ref": "#/components/responses/Detalle"}, "400": {"$ref": "#/components/responses/Datos"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/Ausente"}, "409": {"$ref": "#/components/responses/Estado"}}}},
    "/api/presupuestos/{id}/registrar-aprobacion-cliente/": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "aceptacionCliente024", "description": "AF exclusivo. ENVIADO_CLIENTE -> APROBADO_CLIENTE; permite crear Obra mediante servicio existente, nunca automáticamente.", "requestBody": {"$ref": "#/components/requestBodies/Accion"}, "responses": {"200": {"$ref": "#/components/responses/Detalle"}, "400": {"$ref": "#/components/responses/Datos"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/Ausente"}, "409": {"$ref": "#/components/responses/Estado"}}}},
    "/api/presupuestos/{id}/registrar-rechazo-cliente/": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "rechazoCliente024", "description": "AF exclusivo. ENVIADO_CLIENTE -> RECHAZADO_CLIENTE; motivo obligatorio. S no puede revisar ese rechazo.", "requestBody": {"$ref": "#/components/requestBodies/Motivo"}, "responses": {"200": {"$ref": "#/components/responses/Detalle"}, "400": {"$ref": "#/components/responses/Datos"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/Ausente"}, "409": {"$ref": "#/components/responses/Estado"}}}},
    "/api/presupuestos/{id}/anular/": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "anularPresupuesto024", "description": "AF exclusivo. Estados permitidos de 003B/020A, excluye rechazos y ANULADO. Motivo obligatorio. Obra asociada de cualquier estado: 409 presupuesto_utilizado; lock compartido con crear_obra. Sin borrado físico.", "requestBody": {"$ref": "#/components/requestBodies/Motivo"}, "responses": {"200": {"$ref": "#/components/responses/Detalle"}, "400": {"$ref": "#/components/responses/Datos"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/Ausente"}, "409": {"$ref": "#/components/responses/Estado"}}}},
    "/api/presupuestos/{id}/crear-revision/": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "revisionPresupuesto024", "description": "S: propio RECHAZADO_FINANZAS únicamente. AF: también RECHAZADO_GERENCIA, RECHAZADO_CLIENTE y ANULADO. Nuevo BORRADOR FINANZAS creado_por actor real; FK origen inmediato, nuevas PK de ítems y un evento NULL->BORRADOR. Cliente activo. Origen intacto. Repetir/concurrir puede crear varias revisiones independientes (no idempotente).", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "maxProperties": 0}}}}, "responses": {"201": {"$ref": "#/components/responses/Detalle"}, "400": {"$ref": "#/components/responses/Datos"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/Ausente"}, "409": {"$ref": "#/components/responses/Estado"}}}},
    "/api/presupuestos/{id}/enviar-gerencia/": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "enviarGerenciaRetirado024", "responses": {"401": {"$ref": "#/components/responses/Sesion"}, "403": {"description": "Retirado, todos los roles, antes de recurso/body"}}}},
    "/api/presupuestos/{id}/aprobar-gerencia/": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "aprobarGerenciaRetirado024", "responses": {"401": {"$ref": "#/components/responses/Sesion"}, "403": {"description": "Retirado, todos los roles"}}}},
    "/api/presupuestos/{id}/rechazar-gerencia/": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "rechazarGerenciaRetirado024", "responses": {"401": {"$ref": "#/components/responses/Sesion"}, "403": {"description": "Retirado, todos los roles"}}}}
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}},
    "parameters": {"Id": {"name": "id", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/Id"}}, "Page": {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1}, "description": "Página de 25; fuera de rango 404"}},
    "requestBodies": {"Cabecera": {"required": true, "content": {"application/json": {"schema": {"allOf": [{"$ref": "#/components/schemas/CabeceraParcial"}], "required": ["cliente", "descripcion"]}}}}, "Accion": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "properties": {"motivo": {"type": "string", "maxLength": 2000}}}}}}, "Motivo": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["motivo"], "properties": {"motivo": {"type": "string", "minLength": 1, "maxLength": 2000}}}}}}},
    "schemas": {
      "Id": {"type": "integer", "format": "int64", "minimum": 1, "maximum": 9223372036854775807},
      "ClienteElegible": {"type": "object", "additionalProperties": false, "required": ["id", "nombre_legal", "tipo_cliente"], "properties": {"id": {"$ref": "#/components/schemas/Id"}, "nombre_legal": {"type": "string", "maxLength": 200}, "tipo_cliente": {"enum": ["PERSONA", "EMPRESA"]}}},
      "CabeceraParcial": {"type": "object", "additionalProperties": false, "properties": {"cliente": {"$ref": "#/components/schemas/Id"}, "descripcion": {"type": "string", "minLength": 1, "maxLength": 2000}}},
      "ItemEntrada": {"type": "object", "additionalProperties": false, "properties": {"descripcion": {"type": "string", "minLength": 1, "maxLength": 2000}, "cantidad": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]{1,3})?$", "description": "Decimal exacto, >0, máximo 999999999.999; no JSON number/NaN/exponente"}, "precio_unitario": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]{1,2})?$", "description": "Decimal exacto, 0..9999999999999.99"}, "unidad": {"type": "string", "minLength": 1, "maxLength": 30}, "orden": {"type": "integer", "minimum": 1, "maximum": 2147483647}}},
      "Estado": {"enum": ["BORRADOR", "PENDIENTE_FINANZAS", "APROBADO_FINANZAS", "RECHAZADO_FINANZAS", "PENDIENTE_GERENCIA", "APROBADO_GERENCIA", "RECHAZADO_GERENCIA", "ENVIADO_CLIENTE", "APROBADO_CLIENTE", "RECHAZADO_CLIENTE", "ANULADO"]},
      "Dinero": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$", "description": "Decimal neto exacto en CLP, HALF_UP por línea"},
      "Item": {"type": "object", "additionalProperties": false, "required": ["id", "presupuesto", "descripcion", "cantidad", "unidad", "precio_unitario", "orden", "subtotal"], "properties": {"id": {"$ref": "#/components/schemas/Id"}, "presupuesto": {"$ref": "#/components/schemas/Id"}, "descripcion": {"type": "string", "minLength": 1, "maxLength": 2000}, "cantidad": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{3}$"}, "unidad": {"type": "string", "minLength": 1, "maxLength": 30}, "precio_unitario": {"$ref": "#/components/schemas/Dinero"}, "orden": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "subtotal": {"$ref": "#/components/schemas/Dinero"}}},
      "Presupuesto": {"type": "object", "additionalProperties": false, "required": ["id", "codigo", "cliente", "descripcion", "estado", "politica_aprobacion", "requiere_aprobacion_gerencia", "presupuesto_origen", "creado_por", "creado_en", "actualizado_en", "moneda", "monto_neto"], "properties": {"id": {"$ref": "#/components/schemas/Id"}, "codigo": {"type": "string", "pattern": "^PRE-[0-9]{6,}$"}, "cliente": {"$ref": "#/components/schemas/Id"}, "descripcion": {"type": "string", "minLength": 1, "maxLength": 2000}, "estado": {"$ref": "#/components/schemas/Estado"}, "politica_aprobacion": {"enum": ["FINANZAS", "GERENCIA_LEGADA"]}, "requiere_aprobacion_gerencia": {"type": "boolean"}, "presupuesto_origen": {"type": ["integer", "null"], "minimum": 1}, "creado_por": {"$ref": "#/components/schemas/Id"}, "creado_en": {"type": "string", "format": "date-time"}, "actualizado_en": {"type": "string", "format": "date-time"}, "moneda": {"const": "CLP"}, "monto_neto": {"$ref": "#/components/schemas/Dinero"}, "items": {"type": "array", "items": {"$ref": "#/components/schemas/Item"}}}},
      "Evento": {"type": "object", "additionalProperties": false, "required": ["id", "presupuesto", "estado_anterior", "estado_nuevo", "registrado_por", "motivo", "creado_en"], "properties": {"id": {"$ref": "#/components/schemas/Id"}, "presupuesto": {"$ref": "#/components/schemas/Id"}, "estado_anterior": {"oneOf": [{"$ref": "#/components/schemas/Estado"}, {"type": "null"}]}, "estado_nuevo": {"$ref": "#/components/schemas/Estado"}, "registrado_por": {"$ref": "#/components/schemas/Id"}, "motivo": {"type": "string", "maxLength": 2000}, "creado_en": {"type": "string", "format": "date-time"}}},
      "Pagina": {"type": "object", "required": ["count", "next", "previous", "results"], "properties": {"count": {"type": "integer", "minimum": 0}, "next": {"type": ["string", "null"]}, "previous": {"type": ["string", "null"]}, "results": {"type": "array", "maxItems": 25, "items": {"$ref": "#/components/schemas/Presupuesto"}}}}
    },
    "responses": {
      "Detalle": {"description": "Detalle final autorizado", "content": {"application/json": {"schema": {"allOf": [{"$ref": "#/components/schemas/Presupuesto"}], "required": ["items"]}}}},
      "Sesion": {"description": "401 sesión inválida, expirada, inactiva o revocada"},
      "Permiso": {"description": "403 rol sin capacidad; previo a recurso/estado/body"},
      "Ausente": {"description": "404 inexistente o ajeno al Supervisor, indistinguibles; antes de body/ítem"},
      "Estado": {"description": "409 estado_incompatible o presupuesto_utilizado. Transiciones no idempotentes; repetición no añade evento"},
      "Datos": {"description": "400 campos inválidos/desconocidos/administrados, cliente no elegible, motivo, Decimal, orden o salida inválida; sin SQL/datos ajenos"}
    }
  }
}
