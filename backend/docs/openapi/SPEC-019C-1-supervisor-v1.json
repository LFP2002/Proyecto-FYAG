{
  "openapi": "3.1.0",
  "info": {
    "title": "FYAG — Solicitudes de materiales del Supervisor",
    "version": "1.0.0",
    "description": "Lectura exclusiva de SUPERVISOR_OBRAS. Nombres actuales y stock consultivo; no se modifica el contrato de decisión."
  },
  "paths": {
    "/api/inventario/solicitudes-supervisor/": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "estado",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "PENDIENTE",
                "APROBADA",
                "RECHAZADA"
              ]
            }
          },
          {
            "name": "buscar",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 150,
              "minLength": 1
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Proyección de lectura",
