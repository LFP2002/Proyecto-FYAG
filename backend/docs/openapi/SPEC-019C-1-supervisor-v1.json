              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "next": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "previous": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "resumen": {
                      "type": "object",
                      "properties": {
                        "pendientes": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "aprobadas": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "rechazadas": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "pendientes",
                        "aprobadas",
                        "rechazadas"
                      ],
                      "additionalProperties": false
                    },
                    "results": {
                      "type": "array",
                      "maxItems": 25,
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "obra": {
                            "type": "string"
                          },
                          "obra_estado": {
                            "type": "string"
                          },
                          "material": {
                            "type": "string"
                          },
                          "codigo": {
                            "type": "string"
                          },
                          "unidad": {
                            "type": "string"
                          },
                          "solicitante": {
                            "type": "string"
                          },
                          "estado": {
                            "type": "string",
                            "enum": [
                              "PENDIENTE",
                              "APROBADA",
                              "RECHAZADA"
                            ]
                          },
                          "cantidad_solicitada": {
                            "type": "string",
                            "pattern": "^[0-9]+\\.[0-9]{3}$"
                          },
                          "cantidad_aprobada": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^[0-9]+\\.[0-9]{3}$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "saldo": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^[0-9]+\\.[0-9]{3}$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "justificacion": {
                            "type": "string"
                          },
                          "motivo_decision": {
                            "type": "string"
                          },
                          "decidido_por": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "decidido_en": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "date-time"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "creado_en": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "autorizacion": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 1
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "obra",
                          "obra_estado",
                          "material",
                          "codigo",
                          "unidad",
                          "solicitante",
                          "estado",
                          "cantidad_solicitada",
                          "cantidad_aprobada",
                          "saldo",
                          "justificacion",
                          "motivo_decision",
                          "decidido_por",
                          "decidido_en",
                          "creado_en",
                          "autorizacion"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "count",
                    "next",
                    "previous",
                    "resumen",
                    "results"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Parámetros inválidos"
          },
          "401": {
            "description": "Sesión no disponible"
          },
          "403": {
            "description": "Rol no autorizado"
          },
          "404": {
            "description": "Registro o página no disponible"
          }
        }
      }
    },
