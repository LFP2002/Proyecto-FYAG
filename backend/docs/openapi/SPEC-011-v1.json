{
  "openapi": "3.1.0",
  "info": {
    "title": "FYAG — Reportes y exportaciones reales",
    "version": "1.0.0",
    "description": "Tres consultas tabulares y nueve exportaciones reales. GERENCIA: obras/rentabilidad/cobranzas; ADMINISTRATIVO_FINANZAS: solo cobranzas con proyección idéntica a Gerencia. Otros roles:403. Fuentes PostgreSQL, Decimal oficial por línea, cierre real, con_cobranza. Snapshot REPEATABLE READ READ ONLY por respuesta; no snapshot compartido entre requests. Reportes de gestión, no DTE ni utilidad contable."
  },
  "security": [{"bearerAuth": []}],
  "paths": {
    "/api/reportes/catalogo/": {
      "get": {
        "operationId": "catalogoReportes",
        "description": "No admite query. Solo reportes autorizados al rol; no contiene URLs públicas o temporales.",
        "responses": {"200": {"description": "Catálogo privado por rol.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Catalogo"}}}}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "405": {"$ref": "#/components/responses/Metodo"}, "500": {"$ref": "#/components/responses/Interno"}}
      },
      "head": {"description": "Autorización/validación de GET, sin cuerpo.", "responses": {"200": {"description": "Cabeceras privadas."}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}}},
      "options": {"responses": {"200": {"description": "Metadatos autenticados."}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}}}
    },
    "/api/reportes/obras/": {
      "get": {
        "operationId": "reporteObras",
        "description": "Solo Gerencia. Fecha base CREACION: creado_en y cinco estados. FINALIZACION: solo FINALIZADA por finalizado_en; otro estado contradictorio:400. Orden fecha base DESC, id DESC. Presupuesto por redondeo oficial de líneas, sin costo parcial ni avance ficticio. Totales de todo el filtro.",
        "parameters": [{"$ref": "#/components/parameters/Desde"}, {"$ref": "#/components/parameters/Hasta"}, {"$ref": "#/components/parameters/Cliente"}, {"$ref": "#/components/parameters/EstadoObra"}, {"$ref": "#/components/parameters/FechaBase"}, {"$ref": "#/components/parameters/Page"}],
        "responses": {"200": {"description": "Página de 25 con totales globales del filtro.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PaginaObras"}}}}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "405": {"$ref": "#/components/responses/Metodo"}, "409": {"$ref": "#/components/responses/Integridad"}, "500": {"$ref": "#/components/responses/Interno"}}
      },
      "head": {"description": "Mismos filtros y validación que GET, sin cuerpo.", "responses": {"200": {"description": "Cabeceras privadas."}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}}},
      "options": {"responses": {"200": {"description": "Metadatos solo Gerencia."}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}}}
    },
    "/api/reportes/rentabilidad/": {
      "get": {
        "operationId": "reporteRentabilidad",
        "description": "Solo Gerencia. Obras actualmente FINALIZADA por finalizado_en DESC/id DESC. Cierre inmutable obligatorio; ausencia:409. Margen=presupuesto neto-costo real neto, puede ser negativo. Cortesía no reduce costo; no significa ingreso cobrado ni utilidad contable. No admite estado o fecha_base.",
        "parameters": [{"$ref": "#/components/parameters/Desde"}, {"$ref": "#/components/parameters/Hasta"}, {"$ref": "#/components/parameters/Cliente"}, {"$ref": "#/components/parameters/Page"}],
        "responses": {"200": {"description": "Página y totales del mismo conjunto cerrado.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PaginaRentabilidad"}}}}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "405": {"$ref": "#/components/responses/Metodo"}, "409": {"$ref": "#/components/responses/Integridad"}, "500": {"$ref": "#/components/responses/Interno"}}
      },
      "head": {"description": "Mismos filtros y comprobaciones de GET, sin cuerpo.", "responses": {"200": {"description": "Cabeceras privadas."}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "409": {"$ref": "#/components/responses/Integridad"}}},
      "options": {"responses": {"200": {"description": "Metadatos solo Gerencia."}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}}}
    },
    "/api/reportes/cobranzas/": {
      "get": {
        "operationId": "reporteCobranzas",
        "description": "Gerencia y AF, misma proyección sin costos/márgenes. Solo documentos VIGENTE, pagos activos y clasificación oficial al día civil del corte. Fecha filtrada=fecha_emision, orden fecha_emision DESC/id DESC. No cartera histórica reconstruida. Folio como texto con ceros. Totales sobre todos los documentos del filtro y estado calculado.",
        "parameters": [{"$ref": "#/components/parameters/Desde"}, {"$ref": "#/components/parameters/Hasta"}, {"$ref": "#/components/parameters/Cliente"}, {"$ref": "#/components/parameters/EstadoCobranza"}, {"$ref": "#/components/parameters/Page"}],
        "responses": {"200": {"description": "Página y totales de cartera filtrada.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PaginaCobranzas"}}}}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "405": {"$ref": "#/components/responses/Metodo"}, "409": {"$ref": "#/components/responses/Integridad"}, "500": {"$ref": "#/components/responses/Interno"}}
      },
      "head": {"description": "Mismos filtros y comprobaciones de GET, sin cuerpo.", "responses": {"200": {"description": "Cabeceras privadas."}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "409": {"$ref": "#/components/responses/Integridad"}}},
      "options": {"responses": {"200": {"description": "Metadatos G/AF."}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}}}
    },
    "/api/reportes/{tipo}/exportar/": {
      "parameters": [{"name": "tipo", "in": "path", "required": true, "schema": {"type": "string", "enum": ["obras", "rentabilidad", "cobranzas"]}, "description": "Desconocido para un rol habilitado:404; tipo existente no autorizado:403."}],
      "get": {
        "operationId": "exportarReporte",
        "description": "Archivo completo generado/verificado en snapshot antes de devolver bytes. Mismos filtros/orden/columnas/totales del JSON, sin page. Máximo10000 filas y50MiB, presupuesto operativo60s y máximo2000páginas PDF; sin almacenamiento público. CSV UTF-8 BOM, ; y CRLF, textos neutralizados contra fórmulas; Excel puede inferir folios numéricos: importar como texto o usar XLSX. XLSX sin fórmulas/links, todos los importes/IDs/folios como texto exacto, hojas Resultados/Resumen. PDF horizontal con fuente embebida, filas envueltas, encabezados repetidos, páginas y aviso no tributario. Cliente debe consumir como blob con Bearer, no token en URL. Tasa5/min por usuario/proceso; requiere cache compartida para alcance multiinstancia.",
        "parameters": [{"$ref": "#/components/parameters/Desde"}, {"$ref": "#/components/parameters/Hasta"}, {"$ref": "#/components/parameters/Cliente"}, {"$ref": "#/components/parameters/Formato"}, {"name": "estado", "in": "query", "schema": {"type": "string"}, "description": "Solo obras (cinco estados) o cobranzas (cuatro estados calculados). No permitido en rentabilidad."}, {"$ref": "#/components/parameters/FechaBase"}],
        "responses": {
          "200": {"description": "Archivo auténtico, inclusive cero registros con encabezados y metadatos.", "headers": {"Content-Disposition": {"schema": {"type": "string", "pattern": "^attachment; filename=\"fyag-(obras|rentabilidad|cobranzas)-[0-9]{8}-[0-9]{6}\\.(csv|xlsx|pdf)\"$"}}, "Content-Length": {"schema": {"type": "integer", "maximum": 52428800}}, "Cache-Control": {"schema": {"const": "private, no-store"}}, "Vary": {"schema": {"type": "string"}, "description": "Incluye Authorization."}, "X-Content-Type-Options": {"schema": {"const": "nosniff"}}, "Content-Security-Policy": {"schema": {"const": "default-src 'none'; sandbox"}}}, "content": {"text/csv; charset=utf-8": {"schema": {"type": "string", "format": "binary"}}, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {"schema": {"type": "string", "format": "binary"}}, "application/pdf": {"schema": {"type": "string", "format": "binary"}}}},
          "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"description": "Tipo de reporte no encontrado."}, "405": {"$ref": "#/components/responses/Metodo"}, "409": {"$ref": "#/components/responses/Integridad"}, "413": {"$ref": "#/components/responses/Volumen"}, "429": {"$ref": "#/components/responses/Tasa"}, "500": {"$ref": "#/components/responses/Interno"}
        }
      },
      "head": {"description": "Valida rol, filtros, integridad y máximo de filas sin renderizar ni crear archivo. MIME/Content-Disposition de la descarga esperable, cuerpo vacío; sin Content-Length ficticio. El tamaño comprimido/final solo se conoce al generar en GET y allí se comprueba antes de transmitir.", "parameters": [{"$ref": "#/components/parameters/Desde"}, {"$ref": "#/components/parameters/Hasta"}, {"$ref": "#/components/parameters/Cliente"}, {"$ref": "#/components/parameters/Formato"}, {"name": "estado", "in": "query", "schema": {"type": "string"}, "description": "Solo obras o cobranzas, según su catálogo."}, {"$ref": "#/components/parameters/FechaBase"}], "responses": {"200": {"description": "Sin cuerpo ni generación binaria."}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"description": "Tipo no encontrado."}, "409": {"$ref": "#/components/responses/Integridad"}, "413": {"$ref": "#/components/responses/Volumen"}, "429": {"$ref": "#/components/responses/Tasa"}, "500": {"$ref": "#/components/responses/Interno"}}},
      "options": {"responses": {"200": {"description": "Metadatos, solo rol/tipo autorizado. Sin filas ni archivo."}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"description": "Tipo no encontrado."}}}
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT FYAG con sesion_version"}},
    "parameters": {
      "Desde": {"name": "desde", "in": "query", "schema": {"type": "string", "format": "date"}, "description": "Requiere hasta. YYYY-MM-DD Santiago, máximo366días inclusivos. Sin ambos: día1del mes actual hasta hoy."},
      "Hasta": {"name": "hasta", "in": "query", "schema": {"type": "string", "format": "date"}, "description": "Requiere desde, desde<=hasta<=hoy Santiago. Frontera SQL exclusiva al inicio civil siguiente (DST), sin sumar86400s."},
      "Cliente": {"name": "cliente", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}, "description": "Decimal positivo ASCII sin signos/ceros iniciales/exponentes. No revela datos del cliente inexistente."},
      "Page": {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807, "default": 1}, "description": "Solo JSON. Decimal positivo sin ceros iniciales. Página inválida/fuera de rango:400 con page. Tamaño fijo25."},
      "EstadoObra": {"name": "estado", "in": "query", "schema": {"$ref": "#/components/schemas/EstadoObra"}},
      "EstadoCobranza": {"name": "estado", "in": "query", "schema": {"$ref": "#/components/schemas/EstadoCobranza"}},
      "FechaBase": {"name": "fecha_base", "in": "query", "schema": {"type": "string", "enum": ["CREACION", "FINALIZACION"], "default": "CREACION"}, "description": "Solo tipo obras; rechazada en otros tipos. FINALIZACION exige estado FINALIZADA o estado omitido."},
      "Formato": {"name": "formato", "in": "query", "required": true, "schema": {"type": "string", "enum": ["csv", "xlsx", "pdf"]}, "description": "Solo exportación, obligatorio, minúsculas. Parámetros page/limit no admitidos."}
    },
    "responses": {
      "Validacion": {"description": "Parámetro desconocido/repetido/vacío, tipo/rango/formato inválido o filtros incoherentes. JSON por campo/query.", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}},
      "Sesion": {"description": "JWT ausente, expirado, revocado o usuario inactivo."},
      "Permiso": {"description": "Rol no habilitado o tipo no autorizado, antes de consultar filas. Sin elevación por flags/grupos/claims."},
      "Metodo": {"description": "Solo GET/HEAD/OPTIONS para actor autorizado; no mutaciones."},
      "Integridad": {"description": "Fuente inconsistente; nunca totales parciales engañosos.", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["code", "detail"], "properties": {"code": {"enum": ["cierre_costos_inconsistente", "saldo_inconsistente", "importe_fuera_rango"]}, "detail": {"type": "string"}}}}}},
      "Volumen": {"description": "Sin archivo ni bytes de éxito parciales.", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["code", "detail"], "properties": {"code": {"const": "exportacion_demasiado_grande"}, "detail": {"type": "string"}}}}}},
      "Tasa": {"description": "Tasa de exportación agotada. No sustituye RBAC.", "headers": {"Retry-After": {"schema": {"type": "integer", "minimum": 1}}}},
      "Interno": {"description": "Error saneado o presupuesto de tiempo excedido. Sin SQL, traceback, PII o contenido de archivo; X-Correlation-ID opaco.", "headers": {"X-Correlation-ID": {"schema": {"type": "string", "format": "uuid"}}}, "content": {"application/json": {"schema": {"type": "object", "required": ["detail", "correlacion"], "properties": {"detail": {"type": "string"}, "correlacion": {"type": "string", "format": "uuid"}, "code": {"const": "reporte_tiempo_excedido"}}}}}}
    },
    "schemas": {
      "Importe": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{2}$"},
      "Margen": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]{2}$"},
      "Id": {"type": "integer", "minimum": 1},
      "CodigoObra": {"type": "string", "pattern": "^OB-[0-9]{6,}$"},
      "EstadoObra": {"type": "string", "enum": ["PLANIFICADA", "EN_PROCESO", "SUSPENDIDA", "FINALIZADA", "CANCELADA"]},
      "EstadoCobranza": {"type": "string", "enum": ["PENDIENTE", "PARCIAL", "PAGADA", "VENCIDA"]},
      "Catalogo": {"type": "object", "additionalProperties": false, "required": ["moneda", "zona_horaria", "formatos", "reportes"], "properties": {"moneda": {"const": "CLP"}, "zona_horaria": {"const": "America/Santiago"}, "formatos": {"type": "array", "items": {"enum": ["csv", "xlsx", "pdf"]}, "minItems": 3, "maxItems": 3}, "reportes": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["tipo", "titulo", "filtros", "formatos"], "properties": {"tipo": {"enum": ["obras", "rentabilidad", "cobranzas"]}, "titulo": {"type": "string"}, "filtros": {"type": "array", "items": {"enum": ["desde", "hasta", "cliente", "estado", "fecha_base"]}}, "formatos": {"type": "array", "items": {"enum": ["csv", "xlsx", "pdf"]}}}}}}},
      "Obra": {"type": "object", "additionalProperties": false, "required": ["obra", "codigo_obra", "cliente", "cliente_nombre", "categoria_nombre", "estado", "tecnico_responsable", "tecnico_nombre", "fecha_programada", "creado_en", "finalizado_en", "presupuesto_neto"], "properties": {"obra": {"$ref": "#/components/schemas/Id"}, "codigo_obra": {"$ref": "#/components/schemas/CodigoObra"}, "cliente": {"$ref": "#/components/schemas/Id"}, "cliente_nombre": {"type": "string"}, "categoria_nombre": {"type": "string"}, "estado": {"$ref": "#/components/schemas/EstadoObra"}, "tecnico_responsable": {"type": ["integer", "null"]}, "tecnico_nombre": {"type": ["string", "null"]}, "fecha_programada": {"type": ["string", "null"], "format": "date"}, "creado_en": {"type": "string", "format": "date-time"}, "finalizado_en": {"type": ["string", "null"], "format": "date-time"}, "presupuesto_neto": {"$ref": "#/components/schemas/Importe"}}},
      "Rentabilidad": {"type": "object", "additionalProperties": false, "required": ["obra", "codigo_obra", "cliente", "cliente_nombre", "finalizado_en", "moneda", "presupuesto_neto", "costo_real_neto", "margen_neto", "tiene_cortesia_sin_cobro"], "properties": {"obra": {"$ref": "#/components/schemas/Id"}, "codigo_obra": {"$ref": "#/components/schemas/CodigoObra"}, "cliente": {"$ref": "#/components/schemas/Id"}, "cliente_nombre": {"type": "string"}, "finalizado_en": {"type": "string", "format": "date-time"}, "moneda": {"const": "CLP"}, "presupuesto_neto": {"$ref": "#/components/schemas/Importe"}, "costo_real_neto": {"$ref": "#/components/schemas/Importe"}, "margen_neto": {"$ref": "#/components/schemas/Margen"}, "tiene_cortesia_sin_cobro": {"type": "boolean"}}},
      "Cobranza": {"type": "object", "additionalProperties": false, "required": ["documento", "obra", "codigo_obra", "cliente", "cliente_nombre", "tipo_documento", "folio_externo", "fecha_emision", "fecha_vencimiento", "moneda", "monto_documentado_bruto", "abonado", "saldo", "estado_cobranza"], "properties": {"documento": {"$ref": "#/components/schemas/Id"}, "obra": {"$ref": "#/components/schemas/Id"}, "codigo_obra": {"$ref": "#/components/schemas/CodigoObra"}, "cliente": {"$ref": "#/components/schemas/Id"}, "cliente_nombre": {"type": "string"}, "tipo_documento": {"enum": ["FACTURA_AFECTA", "FACTURA_EXENTA"]}, "folio_externo": {"type": "string", "pattern": "^[0-9]+$", "description": "Conserva ceros iniciales; nunca número JSON."}, "fecha_emision": {"type": "string", "format": "date"}, "fecha_vencimiento": {"type": "string", "format": "date"}, "moneda": {"const": "CLP"}, "monto_documentado_bruto": {"$ref": "#/components/schemas/Importe"}, "abonado": {"$ref": "#/components/schemas/Importe"}, "saldo": {"$ref": "#/components/schemas/Importe"}, "estado_cobranza": {"$ref": "#/components/schemas/EstadoCobranza"}}},
      "TotalesObras": {"type": "object", "additionalProperties": false, "required": ["obras", "presupuesto_neto"], "properties": {"obras": {"type": "integer", "minimum": 0}, "presupuesto_neto": {"$ref": "#/components/schemas/Importe"}}},
      "TotalesRentabilidad": {"type": "object", "additionalProperties": false, "required": ["obras", "presupuesto_neto", "costo_real_neto", "margen_neto"], "properties": {"obras": {"type": "integer", "minimum": 0}, "presupuesto_neto": {"$ref": "#/components/schemas/Importe"}, "costo_real_neto": {"$ref": "#/components/schemas/Importe"}, "margen_neto": {"$ref": "#/components/schemas/Margen"}}},
      "TotalesCobranzas": {"type": "object", "additionalProperties": false, "required": ["documentos", "monto_documentado_bruto", "abonado", "saldo", "saldo_vencido"], "properties": {"documentos": {"type": "integer", "minimum": 0}, "monto_documentado_bruto": {"$ref": "#/components/schemas/Importe"}, "abonado": {"$ref": "#/components/schemas/Importe"}, "saldo": {"$ref": "#/components/schemas/Importe"}, "saldo_vencido": {"$ref": "#/components/schemas/Importe"}}},
      "Sobre": {"type": "object", "required": ["count", "next", "previous", "results", "totales", "periodo", "moneda", "fecha_corte"], "properties": {"count": {"type": "integer", "minimum": 0}, "next": {"type": ["string", "null"], "format": "uri"}, "previous": {"type": ["string", "null"], "format": "uri"}, "periodo": {"type": "object", "additionalProperties": false, "required": ["desde", "hasta"], "properties": {"desde": {"type": "string", "format": "date"}, "hasta": {"type": "string", "format": "date"}}}, "moneda": {"const": "CLP"}, "fecha_corte": {"type": "string", "format": "date-time", "description": "Instante ISO con offset Santiago; no token de snapshot reutilizable."}}},
      "PaginaObras": {"allOf": [{"$ref": "#/components/schemas/Sobre"}, {"properties": {"results": {"type": "array", "maxItems": 25, "items": {"$ref": "#/components/schemas/Obra"}}, "totales": {"$ref": "#/components/schemas/TotalesObras"}}}], "unevaluatedProperties": false},
      "PaginaRentabilidad": {"allOf": [{"$ref": "#/components/schemas/Sobre"}, {"properties": {"results": {"type": "array", "maxItems": 25, "items": {"$ref": "#/components/schemas/Rentabilidad"}}, "totales": {"$ref": "#/components/schemas/TotalesRentabilidad"}}}], "unevaluatedProperties": false},
      "PaginaCobranzas": {"allOf": [{"$ref": "#/components/schemas/Sobre"}, {"properties": {"results": {"type": "array", "maxItems": 25, "items": {"$ref": "#/components/schemas/Cobranza"}}, "totales": {"$ref": "#/components/schemas/TotalesCobranzas"}}}], "unevaluatedProperties": false}
    }
  }
}
