{
  "openapi": "3.1.0",
  "info": {
    "title": "FYAG SPEC-018C C2 — integración controlada QA",
    "version": "1.1.0",
    "description": "Complemento implementado del contrato SPEC-018A-v1.json. DESHABILITADO por defecto. Solo QA_AISLADO_C2 con DB exclusiva, dos recuperadoras TI QA y precondiciones explícitas. Perfil 401_GENERICO y REVOCAR_TODAS_QA, NO RATIFICADOS PARA PRODUCCIÓN. No hay 423 ni desbloqueo simple. No declara SPEC-018 completada ni autoriza despliegue."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "Bearer": []
    }
  ],
  "paths": {
    "/api/auth/login/": {
      "post": {
        "security": [
          {
            "CSRF": [],
            "CSRFCookie": []
          }
        ],
        "summary": "Login normal/restringido o 401 genérico; contador solo en verificación incorrecta vigente",
        "description": "Solo C2 QA habilitada: quinto fallo bloquea, incrementa sesion_version y revoca desafíos/sesiones; ciclos 15/60/240 min y cuarto en 24 h REQUIERE_TI. Inexistente/inactiva/expirada/estado incoherente/bloqueo: 401 genérico sin informar identidad/plazos. Throttle 429 prevalece y no cuenta. JSON inválido no cuenta. Login exitoso rota CSRF. Nunca repetir POST por resultado incierto.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "writeOnly": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Personal: access/user/csrfToken y refresh solo cookie. Temporal: solo desafío/estado/vence/CSRF, elimina refresh previo.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/LoginNormal"
                    },
                    {
                      "$ref": "#/components/schemas/LoginRestringido"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validacion"
          },
          "401": {
            "description": "Mismo body para todos los rechazos de login",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "const": "Credenciales inválidas."
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          },
          "429": {
            "$ref": "#/components/responses/Throttle"
          }
        }
      }
    },
    "/api/auth/refresh/": {
      "post": {
        "security": [
          {
            "CSRF": [],
            "CSRFCookie": [],
            "RefreshCookie": []
          }
        ],
        "summary": "Rotar cookie solo con sesión PERSONAL, versión y acceso vigentes",
        "description": "Body {}. Revalida SQL bajo lock; bloqueos y NO_DISPONIBLE deniegan. No cuenta errores de tokens ni limpia racha. Tokens anteriores a cualquier ciclo QA quedan revocados incluso tras expirar bloqueo.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access y Set-Cookie refresh rotada, sin refresh en JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "access"
                  ],
                  "properties": {
                    "access": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SinSesion"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          },
          "429": {
            "$ref": "#/components/responses/Throttle"
          }
        }
      }
    },
    "/api/auth/me/": {
      "get": {
        "summary": "Perfil sin información de bloqueo; JWT bloqueado/revocado recibe 401",
        "responses": {
          "200": {
            "description": "Perfil operativo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identidad"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SinSesion"
          }
        }
      }
    },
    "/api/auth/primer-cambio-clave/": {
      "post": {
        "security": [
          {
            "CSRF": [],
            "CSRFCookie": []
          }
        ],
        "summary": "Primer cambio exige desafío vigente y ausencia de bloqueo",
        "description": "Sin Authorization. Un bloqueo confirmado limpia/invalida desafíos anteriores; errores no cuentan como contraseña incorrecta. Sin sesión automática.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "desafio",
                  "nueva_clave"
                ],
                "properties": {
                  "desafio": {
                    "type": "string",
                    "maxLength": 128,
                    "writeOnly": true
                  },
                  "nueva_clave": {
                    "type": "string",
                    "maxLength": 4096,
                    "writeOnly": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmado, nuevo login obligatorio",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "estado",
                    "login_requerido"
                  ],
                  "properties": {
                    "estado": {
                      "const": "CLAVE_PERSONAL_CONFIRMADA"
                    },
                    "login_requerido": {
                      "const": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validacion"
          },
          "401": {
            "description": "Desafío no disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Detalle"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          },
          "429": {
            "$ref": "#/components/responses/Throttle"
          }
        }
      }
    },
    "/api/usuarios/": {
      "get": {
        "summary": "Solo TI: estado de acceso adicional cuando C2 QA habilitada",
        "responses": {
          "200": {
            "description": "Paginación Fase A (25), sin N+1; jamás secretos en lecturas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "next": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "previous": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PerfilTI"
                      }
                    },
                    "resumen": {
                      "type": "object",
                      "required": [
                        "total",
                        "activas",
                        "inactivas",
                        "temporales"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "total": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "activas": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "inactivas": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "temporales": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "description": "Totales globales, independientes de búsqueda, rol, estado y página. Temporales cuenta estados persistidos INICIAL/RECUPERACION, incluye vencidas."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SinSesion"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          }
        },
        "parameters": [
          {
            "name": "buscar",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            "description": "Coincidencia parcial sin distinguir mayúsculas en nombre completo, alias o correo."
          },
          {
            "name": "resumen",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            },
            "description": "Incluye resumen global opcional."
          }
        ]
      }
    },
    "/api/usuarios/{id}/": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "get": {
        "summary": "Solo TI: lectura de cuenta; NO_DISPONIBLE nunca significa NORMAL",
        "responses": {
          "200": {
            "description": "Proyección Fase A más campos C2 condicionales",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PerfilTI"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SinSesion"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          },
          "404": {
            "description": "Cuenta no disponible"
          }
        }
      }
    },
    "/api/usuarios/{id}/restablecer-clave/": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "post": {
        "summary": "TI reemite temporal y recupera acceso atómicamente; sin desbloqueo simple",
        "description": "TI activo/persistido, sesión PERSONAL no bloqueada, objetivo ajeno, motivo y verificación manual QA. Conserva is_active. No repara NO_DISPONIBLE. Recup/rol/correo no abren sesión automática. Registra REEMISION y RecuperacionAcceso inmutables enlazados. No reenviar ante red/5xx.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "motivo"
                ],
                "properties": {
                  "motivo": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Única exposición de temporal; estado RECUPERACION y acceso NORMAL, sin reactivar",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PerfilTI"
                    },
                    {
                      "type": "object",
                      "required": [
                        "credencial_temporal",
                        "credencial_vence_en"
                      ],
                      "properties": {
                        "credencial_temporal": {
                          "type": "string",
                          "readOnly": true
                        },
                        "credencial_vence_en": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validacion"
          },
          "401": {
            "$ref": "#/components/responses/SinSesion"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          },
          "404": {
            "description": "Cuenta no disponible"
          },
          "409": {
            "description": "autooperacion_protegida, seguridad_no_disponible o invariantes existentes; sin reparación",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "detail"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "CSRF": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRFToken"
      },
      "CSRFCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "csrftoken"
      },
      "RefreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "fyag_refresh"
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "schemas": {
      "Detalle": {
        "type": "object",
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string"
          }
        }
      },
      "Rol": {
        "type": "string",
        "enum": [
          "GERENCIA",
          "ADMINISTRATIVO_FINANZAS",
          "SUPERVISOR_OBRAS",
          "TECNICO",
          "ADMINISTRADOR_TI"
        ]
      },
      "Identidad": {
        "type": "object",
        "required": [
          "id",
          "username",
          "email",
          "role"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Rol"
          }
        }
      },
      "LoginNormal": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "access",
          "user",
          "csrfToken"
        ],
        "properties": {
          "access": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/Identidad"
          },
          "csrfToken": {
            "type": "string"
          }
        }
      },
      "LoginRestringido": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "estado",
          "desafio",
          "desafio_vence_en",
          "csrfToken"
        ],
        "properties": {
          "estado": {
            "const": "CAMBIO_OBLIGATORIO"
          },
          "desafio": {
            "type": "string"
          },
          "desafio_vence_en": {
            "type": "string",
            "format": "date-time"
          },
          "csrfToken": {
            "type": "string"
          }
        }
      },
      "PerfilTI": {
        "type": "object",
        "description": "Campos Fase A conservados. estado_acceso y bloqueado_hasta solo se añaden al habilitar C2 QA. Sin contadores ni versiones de acceso públicas.",
        "properties": {
          "id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "rol": {
            "$ref": "#/components/schemas/Rol"
          },
          "is_active": {
            "type": "boolean"
          },
          "date_joined": {
            "type": "string",
            "format": "date-time"
          },
          "estado_credencial": {
            "enum": [
              "PERSONAL",
              "INICIAL",
              "RECUPERACION",
              "NO_DISPONIBLE"
            ]
          },
          "cambio_obligatorio": {
            "type": "boolean"
          },
          "estado_acceso": {
            "enum": [
              "NORMAL",
              "BLOQUEO_TEMPORAL",
              "REQUIERE_TI",
              "NO_DISPONIBLE"
            ],
            "readOnly": true
          },
          "bloqueado_hasta": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "readOnly": true
          }
        }
      }
    },
    "responses": {
      "Validacion": {
        "description": "400 esquema/campos/validadores; sin eco de secretos"
      },
      "SinSesion": {
        "description": "401 sesión/credencial no disponible o revocada, sin revelar bloqueo",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Detalle"
            }
          }
        }
      },
      "Prohibido": {
        "description": "403 permisos o CSRF; CSRF puede ser HTML",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Detalle"
            }
          },
          "text/html": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "Throttle": {
        "description": "429 throttle IP/email vigente, no incrementa contador de contraseña",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
