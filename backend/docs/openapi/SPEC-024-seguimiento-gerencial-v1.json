                        "sin_actualizar": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "dias_sin_actualizar": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "respuestas_cliente": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "tasa_aceptacion": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "estados": {
                          "type": "object",
                          "required": [
                            "BORRADOR",
                            "PENDIENTE_FINANZAS",
                            "APROBADO_FINANZAS",
                            "RECHAZADO_FINANZAS",
                            "ENVIADO_CLIENTE",
                            "APROBADO_CLIENTE",
                            "RECHAZADO_CLIENTE",
                            "ANULADO"
                          ],
                          "properties": {
                             "BORRADOR": {
                               "type": "object",
                               "required": [
                                 "cantidad",
                                 "sin_precio",
                                 "monto_neto"
                              ],
                              "properties": {
                                "cantidad": {
                                  "type": "integer",
                                  "minimum": 0
                                },
                                 "sin_precio": {"type":"integer","minimum":0},
                                 "monto_neto": {
                                   "type": ["string", "null"],
                                  "pattern": "^[0-9]+\\.[0-9]{2}$"
