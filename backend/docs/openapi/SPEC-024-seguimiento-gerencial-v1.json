                                },
                                 "sin_precio": {"type":"integer","minimum":0},
                                 "monto_neto": {
                                   "type": ["string", "null"],
                                  "pattern": "^[0-9]+\\.[0-9]{2}$"
                                }
                              }
                            },
                             "RECHAZADO_FINANZAS": {
                               "type": "object",
                               "required": [
                                 "cantidad",
                                 "sin_precio",
                                 "monto_neto"
                              ],
                              "properties": {
                                "cantidad": {
                                  "type": "integer",
                                  "minimum": 0
                                },
                                 "sin_precio": {"type":"integer","minimum":0},
                                 "monto_neto": {
                                   "type": ["string", "null"],
                                  "pattern": "^[0-9]+\\.[0-9]{2}$"
                                }
                              }
                            },
                             "ENVIADO_CLIENTE": {
                               "type": "object",
                               "required": [
                                 "cantidad",
                                 "sin_precio",
                                 "monto_neto"
                              ],
                              "properties": {
                                "cantidad": {
                                  "type": "integer",
                                  "minimum": 0
                                },
                                 "sin_precio": {"type":"integer","minimum":0},
                                 "monto_neto": {
                                   "type": ["string", "null"],
                                  "pattern": "^[0-9]+\\.[0-9]{2}$"
                                }
                              }
                            },
                             "APROBADO_CLIENTE": {
                               "type": "object",
                               "required": [
                                 "cantidad",
                                 "sin_precio",
                                 "monto_neto"
                              ],
                              "properties": {
                                "cantidad": {
                                  "type": "integer",
                                  "minimum": 0
                                },
                                 "sin_precio": {"type":"integer","minimum":0},
                                 "monto_neto": {
                                   "type": ["string", "null"],
                                  "pattern": "^[0-9]+\\.[0-9]{2}$"
                                }
                              }
                            },
                             "RECHAZADO_CLIENTE": {
                               "type": "object",
                               "required": [
                                 "cantidad",
                                 "sin_precio",
                                 "monto_neto"
                              ],
                              "properties": {
                                "cantidad": {
                                  "type": "integer",
                                  "minimum": 0
                                },
                                 "sin_precio": {"type":"integer","minimum":0},
                                 "monto_neto": {
                                   "type": ["string", "null"],
                                  "pattern": "^[0-9]+\\.[0-9]{2}$"
                                }
                              }
                            },
                             "ANULADO": {
                               "type": "object",
                               "required": [
                                 "cantidad",
                                 "sin_precio",
                                 "monto_neto"
                              ],
                              "properties": {
                                "cantidad": {
                                  "type": "integer",
                                  "minimum": 0
                                },
                                 "sin_precio": {"type":"integer","minimum":0},
                                 "monto_neto": {
                                   "type": ["string", "null"],
                                  "pattern": "^[0-9]+\\.[0-9]{2}$"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Filtros inválidos"
          },
          "401": {
            "description": "Sin sesión"
