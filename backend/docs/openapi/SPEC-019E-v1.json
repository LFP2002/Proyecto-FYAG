{
  "openapi": "3.1.0",
  "info": {
    "title": "FYAG — SPEC-019E Materiales del Técnico",
    "version": "1.0.0"
  },
  "paths": {
    "/api/inventario/tecnico-materiales/": {
      "get": {
        "description": "Consulta exclusiva del técnico. Parámetros y formas de respuesta según sección, definidos en SPEC-019E.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "seccion",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "obras",
                "catalogo",
                "entregas",
                "mermas",
                "solicitudes",
                "merma_detalle",
                "solicitud_detalle",
                "confirmacion"
              ]
            },
            "description": "Obligatoria."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Solo paginadas."
          },
          {
            "name": "buscar",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            "description": "Solo paginadas."
          },
          {
            "name": "obra",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Requerido en entregas."
          },
          {
            "name": "estado",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "PENDIENTE",
                "APROBADA",
                "RECHAZADA"
              ]
            },
            "description": "Solo solicitudes y mermas."
          },
          {
            "name": "tipo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "CORTE_NO_REUTILIZABLE",
                "DANO_EN_OBRA",
                "EXTRAVIO_EN_OBRA",
                "OTRA",
                "SOLICITUD",
                "MERMA"
              ]
            },
            "description": "Tipo de merma o confirmación."
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Requerido en detalles."
          },
          {
            "name": "clave",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Requerido en confirmación."
          }
        ],
        "responses": {
          "200": {
            "description": "Proyección de la sección consultada",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/PaginaObra"
                    },
                    {
                      "$ref": "#/components/schemas/PaginaMaterial"
                    },
                    {
                      "$ref": "#/components/schemas/PaginaEntrega"
                    },
                    {
                      "$ref": "#/components/schemas/PaginaMerma"
                    },
                    {
                      "$ref": "#/components/schemas/PaginaSolicitud"
                    },
                    {
                      "$ref": "#/components/schemas/MermaDetalle"
                    },
                    {
                      "$ref": "#/components/schemas/SolicitudDetalle"
                    },
                    {
                      "$ref": "#/components/schemas/Confirmacion"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Parámetros inválidos"
          },
          "401": {
            "description": "Sesión no operativa"
          },
          "403": {
            "description": "Rol no permitido"
          },
          "404": {
            "description": "Recurso o página no disponible"
          }
        }
      }
    }
  },
