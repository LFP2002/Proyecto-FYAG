{
  "openapi": "3.1.0",
  "info": {
    "title": "FYAG — SPEC-025B",
    "version": "1.1.0",
    "description": "Extensión de SPEC-024. Supervisor vincula material sin precio; Finanzas fija el precio de venta en borrador o mediante la acción de revisión. No incluye costos de inventario."
  },
  "paths": {
    "/api/presupuestos/{id}/items/": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Crear ítem libre o vinculado a material activo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ítem creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemRead"
                }
              }
            }
          },
          "400": {
            "description": "Campos inválidos o material no disponible"
          },
          "401": {
            "description": "Sin sesión"
          },
          "403": {
            "description": "Rol no autorizado"
          },
          "404": {
            "description": "Presupuesto fuera de alcance"
          },
          "409": {
            "description": "Estado incompatible"
          }
        }
      }
    },
    "/api/presupuestos/{id}/items/{item_id}/": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        },
        {
          "name": "item_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "patch": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Editar ítem o cambiar vínculo; null desvincula",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ítem actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemRead"
                }
              }
            }
          },
          "400": {
            "description": "Campos inválidos o material no disponible"
          },
          "401": {
            "description": "Sin sesión"
          },
          "403": {
            "description": "Rol no autorizado"
          },
          "404": {
            "description": "Recurso fuera de alcance"
          },
          "409": {
            "description": "Estado incompatible"
          }
        }
      }
    },
    "/api/presupuestos/{id}/items/{item_id}/precio-comercial/": {
      "parameters": [
        {"name":"id","in":"path","required":true,"schema":{"type":"integer","minimum":1}},
        {"name":"item_id","in":"path","required":true,"schema":{"type":"integer","minimum":1}}
      ],
      "patch": {
        "security": [{"bearerAuth":[]}],
        "summary": "Fijar o corregir solo el precio de venta de un material vinculado en revisión",
        "description": "Solo Administrativo/Finanzas. Estados PENDIENTE_FINANZAS o PENDIENTE_GERENCIA legado. No admite cambios de material, cantidad, descripción o unidad.",
        "requestBody": {"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["precio_unitario"],"properties":{"precio_unitario":{"type":"string","pattern":"^[0-9]{1,13}(\\.[0-9]{1,2})?$"}}}}}},
        "responses": {
          "200": {"description":"Ítem actualizado","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ItemRead"}}}},
          "400": {"description":"Precio inválido o campos adicionales"},
          "401": {"description":"Sin sesión"},
          "403": {"description":"Rol no autorizado"},
          "404": {"description":"Presupuesto o ítem inexistente"},
          "409": {"description":"Estado incompatible o ítem libre"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ItemPatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "articulo": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 9223372036854776000,
            "description": "Omitido conserva relación; un artículo distinto descarta el precio anterior; null desvincula y exige un precio libre explícito."
          },
          "descripcion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "unidad": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "cantidad": {
            "type": "string",
            "pattern": "^[0-9]{1,9}(\\.[0-9]{1,3})?$"
          },
          "precio_unitario": {
            "type": "string",
            "pattern": "^[0-9]{1,13}(\\.[0-9]{1,2})?$",
            "description": "Para líneas vinculadas, solo Finanzas. No es costo de inventario."
          },
          "orden": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      },
      "ItemCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cantidad",
          "orden"
        ],
        "if": {"required":["articulo"],"properties":{"articulo":{"type":"integer"}}},
        "else": {"required":["descripcion","unidad","precio_unitario"]},
        "properties": {
          "articulo": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 9223372036854776000,
            "description": "Si se indica un artículo activo, el servidor deriva descripción y unidad."
          },
          "descripcion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "unidad": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "cantidad": {
            "type": "string",
            "pattern": "^[0-9]{1,9}(\\.[0-9]{1,3})?$"
          },
          "precio_unitario": {
            "type": "string",
            "pattern": "^[0-9]{1,13}(\\.[0-9]{1,2})?$",
            "description": "Obligatorio para línea libre; en una vinculada, solo Finanzas puede enviarlo. La omisión deja el precio pendiente."
          },
          "orden": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      },
      "ItemRead": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "articulo",
          "descripcion",
          "unidad",
          "cantidad",
          "precio_unitario",
          "orden",
          "id",
          "presupuesto",
          "codigo_articulo",
          "subtotal"
        ],
        "properties": {
          "articulo": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 9223372036854776000,
            "description": "Omitido conserva relación en PATCH; null desvincula."
          },
          "descripcion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "unidad": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "cantidad": {
            "type": "string",
            "pattern": "^[0-9]{1,9}(\\.[0-9]{1,3})?$"
          },
          "precio_unitario": {
            "type": ["string", "null"],
            "pattern": "^[0-9]{1,13}\\.[0-9]{2}$",
            "description": "Precio comercial neto; null si está pendiente."
          },
          "orden": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "presupuesto": {
            "type": "integer",
            "minimum": 1
          },
          "codigo_articulo": {
            "type": "string",
            "maxLength": 50,
            "description": "Instantánea de código; vacío para línea libre."
          },
          "subtotal": {
            "type": ["string", "null"],
            "description": "Null si el precio está pendiente."
          }
        }
      }
    }
  }
}
