          },
          "cantidad": {
            "type": "string",
            "pattern": "^[0-9]{1,9}(\\.[0-9]{1,3})?$"
          },
          "precio_unitario": {
            "type": "string",
            "pattern": "^[0-9]{1,13}(\\.[0-9]{1,2})?$",
            "description": "Precio neto de venta explícito; independiente de costos."
          },
          "orden": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      },
      "ItemRead": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "articulo",
          "descripcion",
          "unidad",
          "cantidad",
          "precio_unitario",
          "orden",
