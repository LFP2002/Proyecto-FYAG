{
  "openapi": "3.1.0",
  "info": {
    "title": "FYAG — SPEC-004 listado operativo de Supervisor",
    "version": "1.0.0",
    "description": "Addendum del listado GET /api/obras/ para SUPERVISOR_OBRAS. No sustituye las proyecciones ni los permisos de otros roles. No modifica escrituras ni validación/finalización de SPEC-004B."
  },
  "paths": {
    "/api/obras/": {
      "get": {
        "summary": "Listado de obras del Supervisor",
        "description": "Supervisor autenticado: búsqueda opcional antes de paginar. Por defecto, en proceso, planificadas, suspendidas y terminales, con desempate por creación descendente e ID descendente. ordering explícito prevalece. Otros roles conservan contrato original y no admiten buscar en esta ruta.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Página de 25 filas."
          },
          {
            "name": "buscar",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            "description": "Solo Supervisor. Coincidencia parcial de cliente, categoría, nombre completo o usuario del responsable; código OB-numérico exacto. Se recorta espacio exterior y se rechazan caracteres de control, vacío y parámetros duplicados."
          },
          {
            "name": "estado",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "PLANIFICADA",
                "EN_PROCESO",
                "SUSPENDIDA",
                "FINALIZADA",
                "CANCELADA"
              ]
            },
            "description": "Estado exacto."
          },
          {
            "name": "cliente",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854776000
            },
            "description": "Referencia exacta opcional; se conserva por compatibilidad."
          },
          {
            "name": "tecnico_responsable",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854776000
            },
            "description": "Referencia exacta opcional; se conserva por compatibilidad."
          },
          {
            "name": "categoria_servicio",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854776000
            },
            "description": "Referencia exacta opcional; se conserva por compatibilidad."
          },
          {
            "name": "fecha_programada_desde",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Fecha civil inclusiva."
          },
          {
            "name": "fecha_programada_hasta",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Fecha civil inclusiva."
          },
          {
            "name": "ordering",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "creado_en",
                "-creado_en",
                "fecha_programada",
                "-fecha_programada"
              ]
            },
            "description": "Orden explícito; si se omite, prioridad operativa."
          }
        ],
        "responses": {
          "200": {
            "description": "Página de obras",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "count",
                    "next",
                    "previous",
                    "results"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "next": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "previous": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "results": {
                      "type": "array",
                      "maxItems": 25,
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "codigo",
                          "presupuesto",
                          "presupuesto_codigo",
                          "cliente",
                          "cliente_nombre",
                          "categoria_servicio",
                          "categoria_nombre",
                          "descripcion",
                          "tecnico_responsable",
                          "tecnico_nombre",
                          "fecha_programada",
                          "iniciado_en",
                          "estado",
                          "finalizado_en",
                          "cancelado_en",
                          "creado_por",
                          "creado_en",
                          "actualizado_en"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9223372036854776000
                          },
                          "codigo": {
                            "type": "string"
                          },
                          "presupuesto": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9223372036854776000
                          },
                          "presupuesto_codigo": {
                            "type": "string"
                          },
                          "cliente": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9223372036854776000
                          },
                          "cliente_nombre": {
                            "type": "string"
                          },
                          "categoria_servicio": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9223372036854776000
                          },
                          "categoria_nombre": {
                            "type": "string"
                          },
                          "descripcion": {
                            "type": "string"
                          },
                          "tecnico_responsable": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 1
                          },
                          "tecnico_nombre": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "fecha_programada": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date"
                          },
                          "iniciado_en": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "estado": {
                            "type": "string",
                            "enum": [
                              "PLANIFICADA",
                              "EN_PROCESO",
                              "SUSPENDIDA",
                              "FINALIZADA",
                              "CANCELADA"
                            ]
                          },
                          "finalizado_en": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "cancelado_en": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "creado_por": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9223372036854776000
                          },
                          "creado_en": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "actualizado_en": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Filtro inválido, repetido o no admitido."
          },
          "401": {
            "description": "Sin autenticación."
          },
          "403": {
            "description": "Rol sin permiso de lectura."
          },
          "404": {
            "description": "Página inexistente."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
