{
  "openapi": "3.0.3",
  "info": {
    "title": "FYAG — SPEC-018 Fase A: credenciales y primer acceso",
    "version": "1.2.0",
    "description": "Backend SPEC-018 y contrato de consumo externo. Solo desarrollo/QA; TTL temporal 86400 s y desafio 300 s configurables, NO RATIFICADOS PARA PRODUCCION. Entrega manual exclusivamente entre cuentas sinteticas QA. No implementa React ni bloqueos escalonados ni autoriza despliegue. Complementa SPEC-002A/002B/006B/006C. Temporales solo se autentican con request POST resuelto a LoginView; sin request se deniegan."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "Bearer": []
    }
  ],
  "paths": {
    "/api/usuarios/": {
      "get": {
        "summary": "Lista TI; nunca contiene credenciales ni desafios",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "rol",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Rol"
            }
          },
          {
            "name": "activo",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          },
          {
            "name": "buscar",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            "description": "Coincidencia parcial sin distinguir mayúsculas en nombre completo, alias o correo."
          },
          {
            "name": "resumen",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            },
            "description": "Incluye resumen global opcional."
          }
        ],
        "responses": {
          "200": {
            "description": "25 por pagina, ID ascendente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "count",
                    "next",
                    "previous",
                    "results"
                  ],
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "next": {
                      "type": "string",
                      "nullable": true
                    },
                    "previous": {
                      "type": "string",
                      "nullable": true
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Usuario"
                      }
                    },
                    "resumen": {
                      "type": "object",
                      "required": [
                        "total",
                        "activas",
                        "inactivas",
                        "temporales"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "total": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "activas": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "inactivas": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "temporales": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "description": "Totales globales, independientes de búsqueda, rol, estado y página. Temporales cuenta estados persistidos INICIAL/RECUPERACION, incluye vencidas."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validacion"
          },
          "401": {
            "$ref": "#/components/responses/SinSesion"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          },
          "404": {
            "$ref": "#/components/responses/NoDisponible"
          }
        }
      },
      "post": {
        "summary": "TI crea cuenta inactiva y emite credencial de exposicion unica",
        "description": "password y campos administrados por servidor prohibidos. Credencial CSPRNG de 256 bits, solo hash Django en SQL. Perdida de respuesta exige reemision, nunca GET ni reintento automatico.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Alta"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "INICIAL, is_active=false. Secretos solo en esta respuesta",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              },
              "Pragma": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-cache"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Emision"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validacion"
          },
          "401": {
            "$ref": "#/components/responses/SinSesion"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          },
          "409": {
            "$ref": "#/components/responses/Conflicto"
          }
        }
      }
    },
    "/api/usuarios/{id}/": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UsuarioId"
        }
      ],
      "get": {
        "summary": "Detalle TI sin secretos",
        "responses": {
          "200": {
            "description": "Estado administrativo y de credencial separados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SinSesion"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          },
          "404": {
            "$ref": "#/components/responses/NoDisponible"
          }
        }
      },
      "patch": {
        "summary": "TI edita perfil; correo efectivo revoca sesion, incluido correo propio",
        "description": "Solo email/username/first_name/last_name. No-op no audita ni revoca. Tras correo propio confirmado descartar sesion sin refresh ni relectura autenticada (006C).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Perfil"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Perfil confirmado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validacion"
          },
          "401": {
            "$ref": "#/components/responses/SinSesion"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          },
          "404": {
            "$ref": "#/components/responses/NoDisponible"
          },
          "409": {
            "$ref": "#/components/responses/Conflicto"
          }
        }
      }
    },
    "/api/usuarios/{id}/activar/": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UsuarioId"
        }
      ],
      "post": {
        "summary": "TI activa administrativamente; conserva estado y TTL de credencial",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Motivo"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Activacion explicita; no elimina cambio obligatorio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validacion"
          },
          "401": {
            "$ref": "#/components/responses/SinSesion"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          },
          "404": {
            "$ref": "#/components/responses/NoDisponible"
          },
          "409": {
            "$ref": "#/components/responses/Conflicto"
          }
        }
      }
    },
    "/api/usuarios/{id}/desactivar/": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UsuarioId"
        }
      ],
      "post": {
        "summary": "TI desactiva con guardas ultima TI/Gerencia, autooperacion y obligaciones; revoca",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Motivo"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Baja logica, no eliminacion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validacion"
          },
          "401": {
            "$ref": "#/components/responses/SinSesion"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          },
          "404": {
            "$ref": "#/components/responses/NoDisponible"
          },
          "409": {
            "$ref": "#/components/responses/Conflicto"
          }
        }
      }
    },
    "/api/usuarios/{id}/cambiar-rol/": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UsuarioId"
        }
      ],
      "post": {
        "summary": "TI cambia entre los cinco roles actuales; guardas y version vigentes",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rol",
                  "motivo"
                ],
                "properties": {
                  "rol": {
                    "$ref": "#/components/schemas/Rol"
                  },
                  "motivo": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cambio confirmado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validacion"
          },
          "401": {
            "$ref": "#/components/responses/SinSesion"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          },
          "404": {
            "$ref": "#/components/responses/NoDisponible"
          },
          "409": {
            "$ref": "#/components/responses/Conflicto"
          }
        }
      }
    },
    "/api/usuarios/{id}/historial/": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UsuarioId"
        }
      ],
      "get": {
        "summary": "TI consulta eventos paginados sin secretos ni hashes",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "25 eventos por página, orden ascendente por creado_en/id, con desempate por fuente. Incluye recuperaciones por correo e infraestructura de la cuenta objetivo, sin actor autenticado ni snapshots de credenciales.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "count",
                    "next",
                    "previous",
                    "results"
                  ],
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "next": {
                      "type": "string",
                      "nullable": true
                    },
                    "previous": {
                      "type": "string",
                      "nullable": true
                    },
                    "results": {
                      "type": "array",
                      "items": {"oneOf": [{"$ref": "#/components/schemas/Evento"}, {"$ref": "#/components/schemas/EventoRecuperacionCorreo"}, {"$ref": "#/components/schemas/EventoRecuperacionTI"}]}
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validacion"
          },
          "401": {
            "$ref": "#/components/responses/SinSesion"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          },
          "404": {
            "$ref": "#/components/responses/NoDisponible"
          }
        }
      }
    },
    "/api/auth/csrf/": {
      "get": {
        "security": [],
        "summary": "Obtener token CSRF y cookie; no autentica",
        "responses": {
          "200": {
            "description": "Conservar csrfToken en memoria, dejar cookie al navegador",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "csrfToken"
                  ],
                  "properties": {
                    "csrfToken": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me/": {
      "get": {
        "summary": "Perfil operativo propio con access JWT valido; nunca con desafio",
        "responses": {
          "200": {
            "description": "Identidad y rol persistidos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "username",
                    "email",
                    "role"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "username": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "role": {
                      "$ref": "#/components/schemas/Rol"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SinSesion"
          }
        }
      }
    },
    "/api/auth/refresh/": {
      "post": {
        "security": [
          {
            "CSRFHeader": [],
            "CSRFCookie": []
          }
        ],
        "summary": "Rotar cookie refresh, revalidar estado PERSONAL/version/hash; nunca usar desafio",
        "description": "Body {}. Refresh solo desde cookie fyag_refresh, nunca JSON o Authorization. Ausencia, temporal, estado incoherente, version anterior o token usado: 401. Dos renovaciones concurrentes no deben rotar la misma cookie dos veces.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access nuevo y Set-Cookie refresh rotada, sin refresh en JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "access"
                  ],
                  "properties": {
                    "access": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SinSesion"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          },
          "429": {
            "$ref": "#/components/responses/Limitado"
          }
        }
      }
    },
    "/api/auth/logout/": {
      "post": {
        "security": [
          {
            "CSRFHeader": [],
            "CSRFCookie": []
          }
        ],
        "summary": "Revocar refresh actual si existe y eliminar cookie, incluso tras login restringido",
        "description": "Body {}. No consume un desafio opaco: cancelacion del cliente borra memoria; el servidor limita por TTL y sustitucion/consumo/revocacion. No afirmar revocacion de desafio por logout.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Cookie eliminada; sin body"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          }
        }
      }
    },
    "/api/usuarios/{id}/restablecer-clave/": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UsuarioId"
        }
      ],
      "post": {
        "summary": "TI activo/persistido restablece cuenta ajena con motivo",
        "description": "No reactivar ni modificar rol. Genera credencial nueva, RECUPERACION, incrementa sesion_version, invalida desafios y access/refresh anteriores y audita en una transaccion. Prohibe autorrestablecimiento. Ante resets concurrentes solo la ultima credencial queda utilizable; no reintentar automaticamente.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Motivo"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exposicion unica; conserva is_active",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              },
              "Pragma": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-cache"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Emision"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validacion"
          },
          "401": {
            "$ref": "#/components/responses/SinSesion"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          },
          "404": {
            "$ref": "#/components/responses/NoDisponible"
          },
          "409": {
            "$ref": "#/components/responses/Conflicto"
          }
        }
      }
    },
    "/api/usuarios/{id}/establecer-clave/": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UsuarioId"
        }
      ],
      "post": {
        "deprecated": true,
        "summary": "Retirada: nunca establece clave elegida por TI",
        "description": "No procesa nueva_clave. TI autorizado recibe 409 operacion_retirada; sobre si mismo autooperacion_protegida. Utilizar restablecer-clave.",
        "responses": {
          "401": {
            "$ref": "#/components/responses/SinSesion"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          },
          "404": {
            "$ref": "#/components/responses/NoDisponible"
          },
          "409": {
            "$ref": "#/components/responses/Conflicto"
          }
        }
      }
    },
    "/api/auth/login/": {
      "post": {
        "summary": "Sesion normal PERSONAL o desafio restringido temporal",
        "security": [
          {
            "CSRFHeader": [],
            "CSRFCookie": []
          }
        ],
        "description": "Requiere GET csrf previo. Rota CSRF. Inactiva, inexistente, password incorrecto, temporal vencida o estado de seguridad ausente/incoherente: mismo 401 generico. Nunca inferir PERSONAL ni reparar estado al autenticar. La rama temporal NO emite access, user ni refresh; elimina cookie refresh previa. Cada nuevo desafio sustituye al anterior. Validez minima entre TTL de desafio y vencimiento de credencial.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "writeOnly": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Distinguir por estado CAMBIO_OBLIGATORIO; nunca montar negocio en esa rama",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "Sesion normal: refresh HttpOnly/Secure/Strict/path=/api/auth/. Temporal: elimina refresh previo."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/LoginNormal"
                    },
                    {
                      "$ref": "#/components/schemas/LoginRestringido"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validacion"
          },
          "401": {
            "$ref": "#/components/responses/SinSesion"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          },
          "429": {
            "$ref": "#/components/responses/Limitado"
          }
        }
      }
    },
    "/api/auth/primer-cambio-clave/": {
      "post": {
        "summary": "Consume desafio y confirma clave personal; obliga a nuevo login",
        "security": [
          {
            "CSRFHeader": [],
            "CSRFCookie": []
          }
        ],
        "description": "No acepta desafio como Bearer. JSON estricto. Estado, actividad, digest, sesion_version, expiracion y consumo verificados con locks SQL. Rechaza reutilizacion de temporal y valida con Django. Respuesta sin JWT ni sesion automatica. Audita y revoca tokens previos atomicamente.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "desafio",
                  "nueva_clave"
                ],
                "properties": {
                  "desafio": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "writeOnly": true
                  },
                  "nueva_clave": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "writeOnly": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consumido; borrar desafio del cliente, sin reintento automatico",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "estado",
                    "login_requerido"
                  ],
                  "properties": {
                    "estado": {
                      "type": "string",
                      "enum": [
                        "CLAVE_PERSONAL_CONFIRMADA"
                      ]
                    },
                    "login_requerido": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validacion"
          },
          "401": {
            "description": "Desafio no disponible: manipulado, vencido, consumido, reemplazado o version obsoleta; mismo mensaje sin identidad",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Detalle"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          },
          "429": {
            "$ref": "#/components/responses/Limitado"
          }
        }
      }
