{
  "openapi": "3.1.0",
  "info": {"title": "FYAG Beta — SPEC-019B Materiales de Obras", "version": "1.0.0", "description": "Unidades físicas y costos internos, nunca dinero. Conserva catálogo, existencias, ingresos y movimientos de SPEC-019A. Cantidades string de hasta 3 decimales; costos netos string de hasta 2; salidas y retornos son transacciones atómicas con GastoObra. UUID en body, global en Inventario, actor incluido en huella. Replay reconstruye el acto inmutable aun tras devoluciones. Sin precios para Bodega. Stock pendiente de valoración bloquea despachos completos."
  },
  "servers": [{"url": "/"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/api/inventario/autorizaciones-entrega/": {
      "get": {"operationId": "listarAutorizacionesEntrega", "description": "S/G/B; sin costos. Páginas de 25, ID ASC; filtros estrictos articulo/obra/autorizacion/entrega/page. Remanente = cantidad autorizada menos suma de entregas vinculadas.", "parameters": [{"$ref": "#/components/parameters/Articulo"}, {"$ref": "#/components/parameters/Obra"}, {"$ref": "#/components/parameters/Autorizacion"}, {"$ref": "#/components/parameters/Entrega"}, {"$ref": "#/components/parameters/Page"}], "responses": {"200": {"$ref": "#/components/responses/ListaPublica"}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/NoEncontrado"}, "405": {"$ref": "#/components/responses/Metodo"}}},
      "post": {"operationId": "autorizarEntrega", "description": "Solo Supervisor. EN_PROCESO/SUSPENDIDA, artículo activo. No reserva stock ni genera costo. Sin query params.", "requestBody": {"$ref": "#/components/requestBodies/AutorizarEntrega"}, "responses": {"201": {"$ref": "#/components/responses/AltaPublica"}, "200": {"$ref": "#/components/responses/ReplayPublico"}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/NoEncontrado"}, "405": {"$ref": "#/components/responses/Metodo"}, "409": {"$ref": "#/components/responses/Conflicto"}}}
    },
    "/api/inventario/entregas/": {
      "get": {"operationId": "listarEntregas", "description": "S/G/B. B recibe proyección pública sin costo ni gasto; S/G ven snapshots económicos. ID ASC; 25 por página.", "parameters": [{"$ref": "#/components/parameters/Articulo"}, {"$ref": "#/components/parameters/Obra"}, {"$ref": "#/components/parameters/Autorizacion"}, {"$ref": "#/components/parameters/Entrega"}, {"$ref": "#/components/parameters/Page"}], "responses": {"200": {"$ref": "#/components/responses/ListaMixta"}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/NoEncontrado"}, "405": {"$ref": "#/components/responses/Metodo"}}},
      "post": {"operationId": "despacharMaterial", "description": "Solo Bodeguero. Cantidad parcial hasta remanente; artículo activo, stock suficiente y totalmente valorizado. Congela promedio y genera SALIDA + un único GastoObra MATERIAL BODEGA_019B + evento e invalidación de control. Obra EN_PROCESO/SUSPENDIDA. No admite precios ni campos económicos.", "requestBody": {"$ref": "#/components/requestBodies/Ejecutar"}, "responses": {"201": {"$ref": "#/components/responses/AltaPublica"}, "200": {"$ref": "#/components/responses/ReplayPublico"}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/NoEncontrado"}, "405": {"$ref": "#/components/responses/Metodo"}, "409": {"$ref": "#/components/responses/Conflicto"}}}
    },
    "/api/inventario/autorizaciones-devolucion/": {
      "get": {"operationId": "listarAutorizacionesDevolucion", "description": "S/G/B, sin precios. SPEC-019C-2 añade cantidad_recibible_efectiva = max(0,min(autorizada-recibida_de_autorizacion,entregada-MO_aprobada-recibida_total)). No reescribe autorización histórica. Nuevas autorizaciones descuentan todas las cantidades autorizadas y MO aprobada; recepción comprueba entrega menos MO y devoluciones recibidas incluso con autorización antigua. POST/replay conservan proyección original.", "parameters": [{"$ref": "#/components/parameters/Articulo"}, {"$ref": "#/components/parameters/Obra"}, {"$ref": "#/components/parameters/Autorizacion"}, {"$ref": "#/components/parameters/Entrega"}, {"$ref": "#/components/parameters/Page"}], "responses": {"200": {"$ref": "#/components/responses/ListaRetornable"}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/NoEncontrado"}, "405": {"$ref": "#/components/responses/Metodo"}}},
      "post": {"operationId": "autorizarDevolucion", "description": "Solo Supervisor. Identifica entrega y cantidad. No modifica saldo ni gasto hasta la recepción. EN_PROCESO/SUSPENDIDA; no se crean nuevas autorizaciones sobre artículo desactivado.", "requestBody": {"$ref": "#/components/requestBodies/AutorizarDevolucion"}, "responses": {"201": {"$ref": "#/components/responses/AltaPublica"}, "200": {"$ref": "#/components/responses/ReplayPublico"}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/NoEncontrado"}, "405": {"$ref": "#/components/responses/Metodo"}, "409": {"$ref": "#/components/responses/Conflicto"}}}
    },
    "/api/inventario/devoluciones/": {
      "get": {"operationId": "listarDevoluciones", "description": "S/G/B; B sin montos. S/G ven costo histórico aplicado y promedios. ID ASC; 25 por página.", "parameters": [{"$ref": "#/components/parameters/Articulo"}, {"$ref": "#/components/parameters/Obra"}, {"$ref": "#/components/parameters/Autorizacion"}, {"$ref": "#/components/parameters/Entrega"}, {"$ref": "#/components/parameters/Page"}], "responses": {"200": {"$ref": "#/components/responses/ListaMixta"}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/NoEncontrado"}, "405": {"$ref": "#/components/responses/Metodo"}}},
      "post": {"operationId": "recibirDevolucion", "description": "Solo Bodeguero. Recepción parcial hasta remanente autorizado. DEVOLUCION + cantidad_devuelta del gasto original + evento 004B e invalidación. Costo unitario de entrega, no promedio actual. Admite artículo inactivo y nuevos ingresos pendientes si el retorno estaba autorizado. Obra EN_PROCESO/SUSPENDIDA.", "requestBody": {"$ref": "#/components/requestBodies/Ejecutar"}, "responses": {"201": {"$ref": "#/components/responses/AltaPublica"}, "200": {"$ref": "#/components/responses/ReplayPublico"}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/NoEncontrado"}, "405": {"$ref": "#/components/responses/Metodo"}, "409": {"$ref": "#/components/responses/Conflicto"}}}
    },
    "/api/inventario/valorizaciones/": {
      "get": {"operationId": "listarValorizaciones", "description": "Solo AF/G. Libro de costos netos respaldados por ingreso, con cantidad y promedios de origen/resultantes. B usa estados-valorizacion sin precios.", "parameters": [{"$ref": "#/components/parameters/Articulo"}, {"$ref": "#/components/parameters/Page"}], "responses": {"200": {"$ref": "#/components/responses/ListaCostos"}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/NoEncontrado"}, "405": {"$ref": "#/components/responses/Metodo"}}},
      "post": {"operationId": "valorizarIngreso", "description": "Solo AF. Un ingreso posterior al corte; orden ascendente de ID del libro por artículo. Cantidad derivada, no aceptada en body. No mueve stock ni dinero. ROUND_HALF_UP centesimal; no redondear a cero un valor positivo.", "requestBody": {"$ref": "#/components/requestBodies/Valorizar"}, "responses": {"201": {"$ref": "#/components/responses/AltaCosto"}, "200": {"$ref": "#/components/responses/ReplayCosto"}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/NoEncontrado"}, "405": {"$ref": "#/components/responses/Metodo"}, "409": {"$ref": "#/components/responses/Conflicto"}}}
    },
    "/api/inventario/regularizaciones-iniciales/": {
      "get": {"operationId": "listarRegularizaciones", "description": "Solo AF/G. Una regularización por artículo con saldo histórico positivo. Corte verificable conservado en EstadoValoracion, sin modificar libro físico.", "parameters": [{"$ref": "#/components/parameters/Articulo"}, {"$ref": "#/components/parameters/Page"}], "responses": {"200": {"$ref": "#/components/responses/ListaCostos"}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/NoEncontrado"}, "405": {"$ref": "#/components/responses/Metodo"}}},
      "post": {"operationId": "regularizarStockHistorico", "description": "Solo AF, costo respaldado y motivo explícito. Cantidad = saldo histórico capturado por migración. Sin nuevo ingreso ni cambio de saldo físico. Debe preceder la valoración de recepciones nuevas.", "requestBody": {"$ref": "#/components/requestBodies/Regularizar"}, "responses": {"201": {"$ref": "#/components/responses/AltaCosto"}, "200": {"$ref": "#/components/responses/ReplayCosto"}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/NoEncontrado"}, "405": {"$ref": "#/components/responses/Metodo"}, "409": {"$ref": "#/components/responses/Conflicto"}}}
    },
    "/api/inventario/estados-valorizacion/": {
      "get": {"operationId": "estadosValoracionSinMontos", "description": "B/S/AF/G. Solo articulo y estado, nunca costo, promedio ni datos sensibles de Obras. Filtrado estricto articulo/page, ID artículo ASC, 25 por página.", "parameters": [{"$ref": "#/components/parameters/Articulo"}, {"$ref": "#/components/parameters/Page"}], "responses": {"200": {"description": "Estado público autenticado", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PaginaEstados"}}}}, "400": {"$ref": "#/components/responses/Validacion"}, "401": {"$ref": "#/components/responses/Sesion"}, "403": {"$ref": "#/components/responses/Permiso"}, "404": {"$ref": "#/components/responses/NoEncontrado"}, "405": {"$ref": "#/components/responses/Metodo"}}}
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}},
    "parameters": {
      "Articulo": {"name": "articulo", "in": "query", "schema": {"$ref": "#/components/schemas/Id"}},
      "Obra": {"name": "obra", "in": "query", "schema": {"$ref": "#/components/schemas/Id"}},
      "Autorizacion": {"name": "autorizacion", "in": "query", "schema": {"$ref": "#/components/schemas/Id"}},
      "Entrega": {"name": "entrega", "in": "query", "schema": {"$ref": "#/components/schemas/Id"}},
      "Page": {"name": "page", "in": "query", "description": "Entero positivo canónico, sin ceros iniciales; página inexistente 404", "schema": {"type": "integer", "minimum": 1, "maximum": 999999999}}
    },
    "headers": {
      "Replay": {"schema": {"type": "string", "enum": ["false", "true"]}},
      "Cache": {"schema": {"type": "string", "const": "private, no-store"}},
      "Vary": {"description": "Incluye Authorization", "schema": {"type": "string"}}
    },
    "schemas": {
      "Id": {"type": "integer", "format": "int64", "minimum": 1, "maximum": 9223372036854775807},
      "IdNullable": {"type": ["integer", "null"], "format": "int64"},
      "UUID": {"type": "string", "format": "uuid", "description": "Obligatorio, global dentro de Inventario. Mismo actor y payload normalizado = replay; otra carga/acción/actor = 409."},
      "Cantidad": {"type": "string", "pattern": "^[0-9]{1,9}(\\.[0-9]{1,3})?$", "description": "Positiva hasta 999999999.999. Salida con tres posiciones."},
      "Precio": {"type": "string", "pattern": "^[0-9]{1,13}(\\.[0-9]{1,2})?$", "description": "Neto CLP de 0.00 a 9999999999999.99, respaldado explícitamente. Sin floats, exponentes ni truncamiento; salida con dos posiciones."},
      "DecimalNullable": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]{2,3}$"},
      "Referencia": {"type": "string", "minLength": 1, "maxLength": 150, "description": "Texto normalizado sin caracteres de control. Obligatoria y respaldada en valoraciones/regularizaciones."},
      "Motivo": {"type": "string", "minLength": 1, "maxLength": 2000},
      "AutorizarEntrega": {"type": "object", "additionalProperties": false, "required": ["obra", "articulo", "cantidad", "clave_idempotencia"], "properties": {
        "obra": {"$ref": "#/components/schemas/Id"}, "articulo": {"$ref": "#/components/schemas/Id"}, "cantidad": {"$ref": "#/components/schemas/Cantidad"}, "clave_idempotencia": {"$ref": "#/components/schemas/UUID"}, "referencia": {"$ref": "#/components/schemas/Referencia"}, "motivo": {"$ref": "#/components/schemas/Motivo"}
      }},
      "Ejecutar": {"type": "object", "additionalProperties": false, "required": ["autorizacion", "cantidad", "clave_idempotencia"], "properties": {
        "autorizacion": {"$ref": "#/components/schemas/Id"}, "cantidad": {"$ref": "#/components/schemas/Cantidad"}, "clave_idempotencia": {"$ref": "#/components/schemas/UUID"}, "referencia": {"$ref": "#/components/schemas/Referencia"}, "motivo": {"$ref": "#/components/schemas/Motivo"}
      }},
      "AutorizarDevolucion": {"type": "object", "additionalProperties": false, "required": ["entrega", "cantidad", "clave_idempotencia"], "properties": {
        "entrega": {"$ref": "#/components/schemas/Id"}, "cantidad": {"$ref": "#/components/schemas/Cantidad"}, "clave_idempotencia": {"$ref": "#/components/schemas/UUID"}, "referencia": {"$ref": "#/components/schemas/Referencia"}, "motivo": {"$ref": "#/components/schemas/Motivo"}
      }},
      "Valorizar": {"type": "object", "additionalProperties": false, "required": ["ingreso", "costo_unitario_neto", "referencia", "clave_idempotencia"], "properties": {
        "ingreso": {"$ref": "#/components/schemas/Id"}, "costo_unitario_neto": {"$ref": "#/components/schemas/Precio"}, "referencia": {"$ref": "#/components/schemas/Referencia"}, "motivo": {"$ref": "#/components/schemas/Motivo"}, "clave_idempotencia": {"$ref": "#/components/schemas/UUID"}
      }},
      "Regularizar": {"type": "object", "additionalProperties": false, "required": ["articulo", "costo_unitario_neto", "referencia", "motivo", "clave_idempotencia"], "properties": {
        "articulo": {"$ref": "#/components/schemas/Id"}, "costo_unitario_neto": {"$ref": "#/components/schemas/Precio"}, "referencia": {"$ref": "#/components/schemas/Referencia"}, "motivo": {"$ref": "#/components/schemas/Motivo"}, "clave_idempotencia": {"$ref": "#/components/schemas/UUID"}
      }},
      "AutorizacionRetornable": {"type": "object", "additionalProperties": false, "required": ["id", "tipo", "articulo", "obra", "autorizacion", "entrega", "ingreso", "movimiento", "cantidad", "unidad", "clave_idempotencia", "referencia", "motivo", "actor", "creado_en", "cantidad_recibible_efectiva"], "properties": {
        "id": {"$ref": "#/components/schemas/Id"}, "tipo": {"const": "AUTORIZACION_DEVOLUCION"}, "articulo": {"$ref": "#/components/schemas/Id"}, "obra": {"$ref": "#/components/schemas/IdNullable"}, "autorizacion": {"$ref": "#/components/schemas/IdNullable"}, "entrega": {"$ref": "#/components/schemas/IdNullable"}, "ingreso": {"$ref": "#/components/schemas/IdNullable"}, "movimiento": {"$ref": "#/components/schemas/IdNullable"}, "cantidad": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{3}$"}, "unidad": {"type": "string", "maxLength": 30}, "clave_idempotencia": {"$ref": "#/components/schemas/UUID"}, "referencia": {"$ref": "#/components/schemas/Referencia"}, "motivo": {"$ref": "#/components/schemas/Motivo"}, "actor": {"$ref": "#/components/schemas/Id"}, "creado_en": {"type": "string", "format": "date-time"}, "cantidad_recibible_efectiva": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{3}$"}
      }},
      "PaginaRetornable": {"type": "object", "required": ["count", "next", "previous", "results"], "properties": {"count": {"type": "integer", "minimum": 0}, "next": {"type": ["string", "null"]}, "previous": {"type": ["string", "null"]}, "results": {"type": "array", "maxItems": 25, "items": {"$ref": "#/components/schemas/AutorizacionRetornable"}}}},
      "OperacionPublica": {"type": "object", "additionalProperties": false, "required": ["id", "tipo", "articulo", "obra", "autorizacion", "entrega", "ingreso", "movimiento", "cantidad", "unidad", "clave_idempotencia", "referencia", "motivo", "actor", "creado_en"], "properties": {
        "id": {"$ref": "#/components/schemas/Id"}, "tipo": {"type": "string", "enum": ["AUTORIZACION_ENTREGA", "ENTREGA", "AUTORIZACION_DEVOLUCION", "DEVOLUCION"]}, "articulo": {"$ref": "#/components/schemas/Id"}, "obra": {"$ref": "#/components/schemas/IdNullable"}, "autorizacion": {"$ref": "#/components/schemas/IdNullable"}, "entrega": {"$ref": "#/components/schemas/IdNullable"}, "ingreso": {"$ref": "#/components/schemas/IdNullable"}, "movimiento": {"$ref": "#/components/schemas/IdNullable"}, "cantidad": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{3}$"}, "unidad": {"type": "string", "maxLength": 30}, "clave_idempotencia": {"$ref": "#/components/schemas/UUID"}, "referencia": {"$ref": "#/components/schemas/Referencia"}, "motivo": {"$ref": "#/components/schemas/Motivo"}, "actor": {"$ref": "#/components/schemas/Id"}, "creado_en": {"type": "string", "format": "date-time"}
      }},
      "OperacionCosto": {"type": "object", "additionalProperties": false, "required": ["id", "tipo", "articulo", "obra", "autorizacion", "entrega", "ingreso", "movimiento", "cantidad", "unidad", "clave_idempotencia", "referencia", "motivo", "actor", "creado_en", "gasto", "costo_unitario_neto", "saldo_valorado_anterior", "saldo_valorado_posterior", "promedio_anterior", "promedio_posterior"], "properties": {
        "id": {"$ref": "#/components/schemas/Id"}, "tipo": {"type": "string", "enum": ["ENTREGA", "DEVOLUCION", "VALORIZACION", "REGULARIZACION"]}, "articulo": {"$ref": "#/components/schemas/Id"}, "obra": {"$ref": "#/components/schemas/IdNullable"}, "autorizacion": {"$ref": "#/components/schemas/IdNullable"}, "entrega": {"$ref": "#/components/schemas/IdNullable"}, "ingreso": {"$ref": "#/components/schemas/IdNullable"}, "movimiento": {"$ref": "#/components/schemas/IdNullable"}, "cantidad": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{3}$"}, "unidad": {"type": "string", "maxLength": 30}, "clave_idempotencia": {"$ref": "#/components/schemas/UUID"}, "referencia": {"$ref": "#/components/schemas/Referencia"}, "motivo": {"$ref": "#/components/schemas/Motivo"}, "actor": {"$ref": "#/components/schemas/Id"}, "creado_en": {"type": "string", "format": "date-time"},
        "gasto": {"$ref": "#/components/schemas/IdNullable"}, "costo_unitario_neto": {"$ref": "#/components/schemas/DecimalNullable"}, "saldo_valorado_anterior": {"$ref": "#/components/schemas/DecimalNullable"}, "saldo_valorado_posterior": {"$ref": "#/components/schemas/DecimalNullable"}, "promedio_anterior": {"$ref": "#/components/schemas/DecimalNullable"}, "promedio_posterior": {"$ref": "#/components/schemas/DecimalNullable"}
      }},
      "PaginaPublica": {"type": "object", "required": ["count", "next", "previous", "results"], "properties": {"count": {"type": "integer", "minimum": 0}, "next": {"type": ["string", "null"]}, "previous": {"type": ["string", "null"]}, "results": {"type": "array", "maxItems": 25, "items": {"$ref": "#/components/schemas/OperacionPublica"}}}},
      "PaginaMixta": {"type": "object", "required": ["count", "next", "previous", "results"], "properties": {"count": {"type": "integer", "minimum": 0}, "next": {"type": ["string", "null"]}, "previous": {"type": ["string", "null"]}, "results": {"type": "array", "maxItems": 25, "items": {"oneOf": [{"$ref": "#/components/schemas/OperacionPublica"}, {"$ref": "#/components/schemas/OperacionCosto"}]}}}},
      "PaginaCostos": {"type": "object", "required": ["count", "next", "previous", "results"], "properties": {"count": {"type": "integer", "minimum": 0}, "next": {"type": ["string", "null"]}, "previous": {"type": ["string", "null"]}, "results": {"type": "array", "maxItems": 25, "items": {"$ref": "#/components/schemas/OperacionCosto"}}}},
      "PaginaEstados": {"type": "object", "required": ["count", "next", "previous", "results"], "properties": {"count": {"type": "integer", "minimum": 0}, "next": {"type": ["string", "null"]}, "previous": {"type": ["string", "null"]}, "results": {"type": "array", "maxItems": 25, "items": {"type": "object", "additionalProperties": false, "required": ["articulo", "estado"], "properties": {"articulo": {"$ref": "#/components/schemas/Id"}, "estado": {"enum": ["DISPONIBLE", "PENDIENTE_VALORIZACION"]}}}}}},
      "ErrorValidacion": {"type": "object", "additionalProperties": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}},
      "ErrorDetalle": {"type": "object", "required": ["detail"], "properties": {"detail": {"type": "string"}}},
      "ErrorConflicto": {"type": "object", "required": ["code", "detail"], "properties": {"code": {"enum": ["estado_incompatible", "idempotencia_conflictiva", "remanente_insuficiente", "valoracion_pendiente", "orden_valoracion", "existencia_insuficiente", "saldo_fuera_rango", "importe_fuera_rango"]}, "detail": {"type": "string"}}}
    },
    "requestBodies": {
      "AutorizarEntrega": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AutorizarEntrega"}}}},
      "Ejecutar": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ejecutar"}}}},
      "AutorizarDevolucion": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AutorizarDevolucion"}}}},
      "Valorizar": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Valorizar"}}}},
      "Regularizar": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Regularizar"}}}}
    },
    "responses": {
      "ListaRetornable": {"description": "Autorizaciones originales y remanente efectivamente recibible según MO/retornos actuales", "headers": {"Cache-Control": {"$ref": "#/components/headers/Cache"}, "Vary": {"$ref": "#/components/headers/Vary"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PaginaRetornable"}}}},
      "AltaPublica": {"description": "Acto inmutable original (201, replay false)", "headers": {"Idempotency-Replayed": {"$ref": "#/components/headers/Replay"}, "Cache-Control": {"$ref": "#/components/headers/Cache"}, "Vary": {"$ref": "#/components/headers/Vary"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OperacionPublica"}}}},
      "ReplayPublico": {"description": "Mismo acto original (200, replay true), incluso tras devolver", "headers": {"Idempotency-Replayed": {"$ref": "#/components/headers/Replay"}, "Cache-Control": {"$ref": "#/components/headers/Cache"}, "Vary": {"$ref": "#/components/headers/Vary"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OperacionPublica"}}}},
