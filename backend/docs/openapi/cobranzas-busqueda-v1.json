    "/api/finanzas/obras-elegibles/": {
      "get": {
        "description": "Solo Finanzas; conserva las condiciones de elegibilidad.",
        "parameters": [
          {
            "name": "buscar",
            "in": "query",
            "required": false,
            "description": "Nombre legal del cliente (coincidencia parcial insensible a mayúsculas), folio externo parcial o código OB completo. En obras elegibles no se busca por folio. Se aplica antes de paginar y agregar.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lectura financiera",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "next": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "previous": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "results": {
                      "type": "array",
                      "maxItems": 25,
                      "items": {
                        "$ref": "#/components/schemas/Origen"
