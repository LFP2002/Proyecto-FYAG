{
  "openapi": "3.1.0",
  "info": {
    "title": "FYAG — Búsqueda global de facturas y cobranzas",
    "version": "1.0.0",
    "description": "Complemento a SPEC-007: extensión de filtros GET, sin modificar escrituras, permisos ni proyecciones de respuesta."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/finanzas/cobranzas/": {
      "get": {
        "description": "Cartera vigente, Finanzas y Gerencia.",
        "parameters": [
          {
            "name": "buscar",
            "in": "query",
            "required": false,
            "description": "Nombre legal del cliente (coincidencia parcial insensible a mayúsculas), folio externo parcial o código OB completo. En obras elegibles no se busca por folio. Se aplica antes de paginar y agregar.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "cliente",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "obra",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "fecha_emision_desde",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "fecha_emision_hasta",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "estado",
            "in": "query",
            "schema": {
              "enum": [
                "PENDIENTE",
                "PARCIAL",
                "PAGADA",
                "VENCIDA"
              ]
            }
          },
          {
            "name": "fecha_vencimiento_desde",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "fecha_vencimiento_hasta",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lectura financiera",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "next": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "previous": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "results": {
                      "type": "array",
                      "maxItems": 25,
                      "items": {
                        "$ref": "#/components/schemas/Documento"
                      }
                    }
                  },
                  "required": [
                    "count",
                    "next",
                    "previous",
                    "results"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Filtro inválido o repetido"
          },
          "401": {
            "description": "No autenticado"
          },
          "403": {
            "description": "No autorizado"
          },
          "404": {
            "description": "Página no disponible"
          }
        }
      }
    },
    "/api/finanzas/cobranzas/resumen/": {
      "get": {
        "description": "Totales globales sobre los mismos filtros de la cartera.",
        "parameters": [
          {
            "name": "buscar",
            "in": "query",
            "required": false,
            "description": "Nombre legal del cliente (coincidencia parcial insensible a mayúsculas), folio externo parcial o código OB completo. En obras elegibles no se busca por folio. Se aplica antes de paginar y agregar.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            }
          },
          {
            "name": "cliente",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "obra",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "fecha_emision_desde",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "fecha_emision_hasta",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "estado",
            "in": "query",
            "schema": {
              "enum": [
                "PENDIENTE",
                "PARCIAL",
                "PAGADA",
                "VENCIDA"
              ]
            }
          },
          {
            "name": "fecha_vencimiento_desde",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "fecha_vencimiento_hasta",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lectura financiera",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "moneda": {
                      "const": "CLP"
                    },
                    "documentos": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "conteos": {
                      "type": "object",
                      "properties": {
                        "PENDIENTE": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "PARCIAL": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "PAGADA": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "VENCIDA": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "PENDIENTE",
                        "PARCIAL",
                        "PAGADA",
                        "VENCIDA"
                      ]
                    },
                    "monto_documentado_total": {
                      "type": "string",
                      "pattern": "^[0-9]+\\.[0-9]{2}$"
                    },
                    "abonado_total": {
                      "type": "string",
                      "pattern": "^[0-9]+\\.[0-9]{2}$"
                    },
                    "saldo_total": {
                      "type": "string",
                      "pattern": "^[0-9]+\\.[0-9]{2}$"
                    },
                    "saldo_vencido": {
                      "type": "string",
                      "pattern": "^[0-9]+\\.[0-9]{2}$"
                    }
                  },
                  "required": [
                    "moneda",
                    "documentos",
                    "conteos",
                    "monto_documentado_total",
                    "abonado_total",
                    "saldo_total",
                    "saldo_vencido"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Filtro inválido o repetido"
          },
          "401": {
            "description": "No autenticado"
          },
          "403": {
            "description": "No autorizado"
          },
          "404": {
            "description": "Página no disponible"
          }
        }
      }
    },
