  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Origen": {
        "type": "object",
        "properties": {
          "obra": {
            "type": "integer",
            "minimum": 1
          },
          "codigo_obra": {
            "type": "string"
          },
          "presupuesto": {
            "type": "integer",
            "minimum": 1
          },
          "codigo_presupuesto": {
            "type": "string"
          },
          "cliente": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "nombre_legal": {
                "type": "string"
              },
              "tipo_identificacion": {
                "type": "string"
              },
              "numero_identificacion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pais_identificacion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tipo_documento_extranjero": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "nombre_legal",
              "tipo_identificacion",
              "numero_identificacion",
              "pais_identificacion",
              "tipo_documento_extranjero"
            ]
          },
          "moneda": {
            "const": "CLP"
          },
          "monto_neto_aprobado": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$"
          },
          "finalizado_en": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "cortesia": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "tipo": {
                    "const": "SIN_COBRO"
                  }
                },
                "required": [
                  "id",
                  "tipo"
                ]
              }
            ]
          }
        },
        "required": [
          "obra",
          "codigo_obra",
          "presupuesto",
          "codigo_presupuesto",
          "cliente",
          "moneda",
          "monto_neto_aprobado",
          "finalizado_en",
          "cortesia"
        ]
      },
      "Documento": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "naturaleza": {
            "const": "REGISTRO_ADMINISTRATIVO_DOCUMENTO_EXTERNO"
          },
          "origen": {
            "$ref": "#/components/schemas/Origen"
          },
          "tipo_documento": {
            "enum": [
              "FACTURA_AFECTA",
              "FACTURA_EXENTA"
            ]
          },
          "folio_externo": {
            "type": "string"
          },
          "fecha_emision": {
            "type": "string",
            "format": "date"
          },
          "fecha_vencimiento": {
            "type": "string",
            "format": "date"
          },
          "monto_neto": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$"
          },
          "monto_impuesto": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$"
          },
          "monto_total": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$"
          },
          "referencia_respaldo": {
            "type": "string"
          },
          "estado": {
            "enum": [
              "VIGENTE",
              "REVERTIDO"
            ]
          },
          "registrado_por": {
            "type": "integer",
            "minimum": 1
          },
          "registrado_en": {
            "type": "string",
            "format": "date-time"
          },
          "revertido_por": {
            "type": [
              "integer",
              "null"
            ]
          },
          "revertido_en": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "motivo_reversion": {
            "type": [
              "string",
              "null"
            ]
          },
          "referencia_rectificacion_externa": {
            "type": [
              "string",
              "null"
            ]
          },
          "cobranza": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "moneda": {
                    "const": "CLP"
                  },
                  "abonado": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]{2}$"
                  },
                  "saldo": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]{2}$"
                  },
                  "estado": {
                    "enum": [
                      "PENDIENTE",
                      "PARCIAL",
                      "PAGADA",
                      "VENCIDA"
                    ]
                  }
                },
                "required": [
                  "moneda",
                  "abonado",
                  "saldo",
                  "estado"
                ]
              }
            ]
          }
        },
        "required": [
          "id",
          "naturaleza",
          "origen",
          "tipo_documento",
          "folio_externo",
          "fecha_emision",
          "fecha_vencimiento",
          "monto_neto",
          "monto_impuesto",
          "monto_total",
          "referencia_respaldo",
          "estado",
          "registrado_por",
          "registrado_en",
          "revertido_por",
          "revertido_en",
          "motivo_reversion",
          "referencia_rectificacion_externa",
          "cobranza"
        ]
      }
    }
  }
}
