server {
    listen 127.0.0.1:8081;
    access_log off;
    return 204;
}
server {
    listen 8080 default_server;
    listen [::]:8080 default_server;
    if ($host != ${FYAG_PUBLIC_HOST}) { return 421; }
    return 308 ${FYAG_PUBLIC_ORIGIN}$request_uri;
}
server {
    listen 8443 ssl default_server;
    listen [::]:8443 ssl default_server;
    ssl_reject_handshake on;
    return 421;
}
server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name ${FYAG_PUBLIC_HOST};
    if ($host != ${FYAG_PUBLIC_HOST}) { return 421; }
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_certificate /run/secrets/web_cert;
    ssl_certificate_key /run/secrets/web_key;
    ssl_session_tickets off;
    add_header Strict-Transport-Security 'max-age=31536000' always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy 'camera=(), microphone=(), geolocation=()' always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ${FYAG_WSS_ORIGIN}; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;
    limit_conn clients 80;

    location ^~ /api/ {
        limit_req zone=api burst=60 nodelay;
        proxy_pass http://fyag;
        include /etc/fyag/upstream.conf;
        proxy_set_header Connection '';
        proxy_set_header Upgrade '';
        proxy_read_timeout 90s;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
    }
    location = /ws/chat/ {
        if ($http_upgrade !~* '^websocket$') { return 426; }
        limit_req zone=ws burst=12 nodelay;
        proxy_pass http://fyag;
        include /etc/fyag/upstream.conf;
        proxy_set_header Upgrade websocket;
        proxy_set_header Connection upgrade;
        proxy_read_timeout 75s;
    }
    location ~ ^/(admin|health|ws|api|media|static)(/|$) { return 404; }
    root /usr/share/nginx/html;
    location /assets/ { expires 1y; try_files $uri =404; }
    location = /index.html { expires -1; }
    location / { try_files $uri $uri/ /index.html; }
}
